/* =========================================================
   GLOBAL
========================================================= */

* {
  box-sizing: border-box;
}

html,
body,
#app {
  min-height: 100%;
}

html {
  background: #f6f8fc;
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;

  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  background: #f6f8fc;
  color: #172033;

  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

button,
input,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

a {
  color: inherit;
  text-decoration: none;
}

#app {
  min-height: 100vh;
}


/* =========================================================
   APP SHELL
========================================================= */

.app-shell {
  min-height: 100vh;

  background:
    radial-gradient(
      circle at 6% 4%,
      rgba(59, 130, 246, 0.1),
      transparent 30%
    ),
    radial-gradient(
      circle at 94% 0%,
      rgba(99, 102, 241, 0.08),
      transparent 34%
    ),
    #f6f8fc;
}


/* =========================================================
   SIDEBAR
========================================================= */

.sidebar {
  position: fixed;
  top: 16px;
  left: 16px;
  bottom: 16px;

  width: 250px;

  display: flex;
  flex-direction: column;
  justify-content: space-between;

  padding: 24px 14px;

  overflow: hidden;

  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 26px;

  background:
    linear-gradient(
      165deg,
      rgba(16, 24, 39, 0.94) 0%,
      rgba(21, 31, 49, 0.96) 55%,
      rgba(15, 23, 38, 0.97) 100%
    );

  -webkit-backdrop-filter: blur(26px) saturate(150%);
  backdrop-filter: blur(26px) saturate(150%);

  color: #ffffff;

  z-index: 100;

  box-shadow:
    0 24px 60px rgba(15, 23, 42, 0.42),
    0 4px 14px rgba(15, 23, 42, 0.25),
    inset 0 1px 0 rgba(255, 255, 255, 0.07);
}

.sidebar::before {
  content: "";

  position: absolute;
  top: -90px;
  left: -70px;

  width: 340px;
  height: 340px;

  background:
    radial-gradient(
      circle,
      rgba(59, 130, 246, 0.3),
      transparent 65%
    );

  pointer-events: none;

  z-index: 0;
}

.sidebar::after {
  content: "";

  position: absolute;
  right: -80px;
  bottom: -60px;

  width: 260px;
  height: 260px;

  background:
    radial-gradient(
      circle,
      rgba(99, 102, 241, 0.16),
      transparent 65%
    );

  pointer-events: none;

  z-index: 0;
}

.sidebar-top,
.sidebar-bottom {
  position: relative;
  z-index: 1;
}

.sidebar-top {
  width: 100%;
}


/* =========================================================
   BRAND
========================================================= */

.brand {
  display: flex;
  align-items: center;

  gap: 12px;

  padding: 3px 10px 28px;
}

.brand-logo {
  width: 43px;
  height: 43px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  border-radius: 13px;

  background:
    linear-gradient(
      135deg,
      #3b82f6,
      #6366f1
    );

  box-shadow:
    0 10px 24px rgba(59, 130, 246, 0.28);
}

.brand-logo span {
  font-size: 20px;
  line-height: 1;
}

.brand-text {
  min-width: 0;
}

.brand-text h2 {
  margin: 0;

  color: #ffffff;

  font-size: 16px;
  font-weight: 850;

  letter-spacing: -0.2px;
}

.brand-text span {
  display: block;

  margin-top: 2px;

  color: #8f9aad;

  font-size: 10px;
}


/* =========================================================
   SIDEBAR NAVIGATION
========================================================= */

.sidebar-nav {
  display: flex;
  flex-direction: column;

  gap: 6px;
}

.nav-heading {
  display: block;

  padding: 0 12px 10px;

  color: #667286;

  font-size: 9px;
  font-weight: 800;

  letter-spacing: 1.3px;
}

.nav-item {
  display: flex;
  align-items: center;

  gap: 11px;

  min-height: 44px;

  padding: 0 12px;

  border-radius: 12px;

  color: #9da8b9;

  font-size: 13px;
  font-weight: 650;

  transition:
    background 0.2s ease,
    color 0.2s ease,
    transform 0.2s ease;
}

.nav-item:hover {
  color: #ffffff;
  background: rgba(255, 255, 255, 0.055);
}

.nav-item.active {
  color: #ffffff;

  background:
    linear-gradient(
      135deg,
      rgba(37, 99, 235, 0.95),
      rgba(79, 70, 229, 0.95)
    );

  box-shadow:
    0 12px 26px rgba(37, 99, 235, 0.42),
    inset 0 1px 0 rgba(255, 255, 255, 0.18);
}

.nav-item-icon {
  width: 20px;

  display: flex;
  justify-content: center;

  font-size: 16px;
}


/* =========================================================
   SIDEBAR USER
========================================================= */

.sidebar-bottom {
  display: flex;
  flex-direction: column;

  gap: 13px;

  padding: 13px 12px 12px;

  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 18px;

  background: rgba(255, 255, 255, 0.05);
}

.sidebar-user {
  display: flex;
  align-items: center;

  gap: 10px;
}

.user-avatar {
  width: 36px;
  height: 36px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  border-radius: 10px;

  background:
    linear-gradient(
      135deg,
      #e0e7ff,
      #dbeafe
    );

  color: #4338ca;

  font-size: 12px;
  font-weight: 850;
}

.user-details {
  min-width: 0;
}

.user-details strong {
  display: block;

  color: #ffffff;

  font-size: 12px;
}

.user-details span {
  display: block;

  margin-top: 2px;

  color: #778399;

  font-size: 9px;
}


/* =========================================================
   SYSTEM STATUS
========================================================= */

.system-status {
  padding-top: 14px;

  border-top:
    1px solid rgba(255, 255, 255, 0.08);
}

.status-title {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-bottom: 10px;

  color: #667286;

  font-size: 8px;
  font-weight: 800;

  letter-spacing: 1px;
  text-transform: uppercase;
}

.overall-status {
  font-size: 8px;
  font-weight: 800;

  letter-spacing: 0;
  text-transform: none;
}

.overall-online {
  color: #4ade80;
}

.overall-offline {
  color: #fb7185;
}

.overall-checking {
  color: #fbbf24;
}

.status-item {
  display: flex;
  align-items: center;

  gap: 8px;

  min-height: 25px;

  color: #8f9aad;

  font-size: 9px;
}

.status-value {
  margin-left: auto;

  font-size: 8px;
}

.status-indicator {
  width: 6px;
  height: 6px;

  flex-shrink: 0;

  border-radius: 50%;
}

.status-online {
  background: #22c55e;

  box-shadow:
    0 0 0 3px rgba(34, 197, 94, 0.08);
}

.status-offline {
  background: #ef4444;

  box-shadow:
    0 0 0 3px rgba(239, 68, 68, 0.08);
}

.status-checking {
  background: #f59e0b;

  box-shadow:
    0 0 0 3px rgba(245, 158, 11, 0.08);
}

.logout-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;

  width: 100%;
  min-height: 34px;

  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 10px;

  background: rgba(255, 255, 255, 0.04);
  color: #cbd5e1;

  font: inherit;
  font-size: 10px;
  font-weight: 700;

  cursor: pointer;
  transition:
    background 160ms ease,
    color 160ms ease,
    border-color 160ms ease;
}

.logout-button:hover {
  border-color: rgba(248, 113, 113, 0.45);
  background: rgba(248, 113, 113, 0.12);
  color: #fecaca;
}


/* =========================================================
   MOBILE SIDEBAR
========================================================= */

.sidebar-overlay {
  display: none;
}

.mobile-close {
  display: none;

  margin-left: auto;

  padding: 0;

  border: none;

  background: transparent;

  color: #94a3b8;

  font-size: 24px;

  line-height: 1;
}

.mobile-menu {
  display: none;
}


/* =========================================================
   MAIN CONTENT
========================================================= */

.main-content {
  min-height: 100vh;

  margin-left: 282px;

  padding: 16px;

  background:
    radial-gradient(
      circle at 88% -6%,
      rgba(99, 102, 241, 0.035),
      transparent 34%
    ),
    radial-gradient(
      circle at 8% 0%,
      rgba(59, 130, 246, 0.06),
      transparent 36%
    ),
    #f6f8fc;
}


/* =========================================================
   TOPBAR
========================================================= */

.topbar {
  position: sticky;
  top: 16px;

  height: 66px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 22px;

  border: 1px solid rgba(255, 255, 255, 0.9);
  border-radius: 18px;

  background: rgba(255, 255, 255, 0.78);

  -webkit-backdrop-filter: blur(20px) saturate(170%);
  backdrop-filter: blur(20px) saturate(170%);

  box-shadow:
    0 10px 34px rgba(15, 23, 42, 0.1),
    0 2px 8px rgba(15, 23, 42, 0.05);

  z-index: 50;
}


/* Floating bar: mask strip so content can't peek above it */
.topbar::before {
  content: "";

  position: absolute;
  left: -1px;
  right: -1px;
  top: -17px;
  height: 17px;

  background: rgba(246, 248, 252, 0.97);

  pointer-events: none;
}


/* Signature gradient hairline */
.topbar::after {
  content: "";

  position: absolute;
  left: 26px;
  right: 26px;
  bottom: -1px;

  height: 2px;

  border-radius: 99px;

  background:
    linear-gradient(
      90deg,
      rgba(59, 130, 246, 0.9),
      rgba(99, 102, 241, 0.75) 55%,
      rgba(99, 102, 241, 0) 100%
    );

  pointer-events: none;
}

.topbar-breadcrumb {
  display: flex;
  align-items: center;

  gap: 9px;
}

.topbar-breadcrumb span:first-child {
  color: #98a2b3;

  font-size: 9px;
  font-weight: 800;

  letter-spacing: 1.2px;
}

.breadcrumb-separator {
  color: #c5cad3;

  font-size: 11px;
}

.topbar-breadcrumb strong {
  color: #344054;

  font-size: 12px;
  font-weight: 700;
}

.topbar-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  gap: 7px;

  min-height: 40px;

  padding: 0 18px;

  border-radius: 999px;

  background:
    linear-gradient(
      135deg,
      #2563eb,
      #4f46e5
    );

  color: #ffffff;

  font-size: 11px;
  font-weight: 800;

  box-shadow:
    0 8px 22px rgba(37, 99, 235, 0.32);

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease;
}

.topbar-action:hover {
  transform: translateY(-1px);

  box-shadow:
    0 12px 28px rgba(37, 99, 235, 0.4);
}


/* =========================================================
   PAGE CONTAINER
========================================================= */

.page-container {
  width: 100%;

  padding: 26px 8px 36px;
}


/* =========================================================
   COMMON
========================================================= */

.section-label {
  display: flex;
  align-items: center;

  gap: 8px;

  color: #98a2b3;

  font-size: 9px;
  font-weight: 850;

  letter-spacing: 1.2px;
}

.section-label::before {
  content: "";

  flex-shrink: 0;

  width: 16px;
  height: 3px;

  border-radius: 99px;

  background: linear-gradient(90deg, #3b82f6, #6366f1);
}


/* =========================================================
   CONTACT DASHBOARD
========================================================= */

.contact-list {
  width: 100%;

  margin: 0;
  padding: 0;
}

.dashboard-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 20px;

  margin-bottom: 20px;
  padding: 20px 24px;

  border: 1px solid rgba(255, 255, 255, 0.9);
  border-radius: 20px;

  background: rgba(255, 255, 255, 0.75);

  -webkit-backdrop-filter: blur(18px);
  backdrop-filter: blur(18px);

  box-shadow:
    0 10px 34px rgba(15, 23, 42, 0.06);
}

.dashboard-heading h1 {
  margin: 5px 0 0;

  background: linear-gradient(120deg, #101828 55%, #1d4ed8);

  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;

  font-size: 30px;
  font-weight: 850;

  letter-spacing: -0.8px;
}

.dashboard-heading p {
  margin: 7px 0 0;

  color: #7a8494;

  font-size: 12px;
}

.dashboard-date {
  display: flex;
  align-items: center;

  gap: 8px;

  padding: 9px 15px;

  border: 1px solid #e6eaf0;
  border-radius: 999px;

  background: #ffffff;

  color: #98a2b3;
}

.dashboard-date span {
  font-size: 8px;
  font-weight: 850;

  letter-spacing: 0.9px;
}

.dashboard-date strong {
  color: #344054;

  font-size: 12px;
}


/* =========================================================
   STATS
========================================================= */

.stats-row {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 16px;

  margin-bottom: 20px;
}

.stat-card {
  display: flex;
  align-items: center;

  gap: 13px;

  min-height: 88px;

  padding: 17px 19px;

  border: 1px solid #e8ecf2;
  border-radius: 18px;

  background: rgba(255, 255, 255, 0.76);

  -webkit-backdrop-filter: blur(16px);
  backdrop-filter: blur(16px);

  box-shadow:
    0 10px 30px rgba(15, 23, 42, 0.06);

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease;
}

.stat-card:hover {
  transform: translateY(-3px);

  box-shadow:
    0 16px 38px rgba(15, 23, 42, 0.09);
}

.stat-icon {
  width: 41px;
  height: 41px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  border-radius: 11px;

  font-size: 16px;
  font-weight: 850;
}

.stat-icon.blue {
  background: #eff6ff;
  color: #2563eb;
}

.stat-icon.purple {
  background: #f5f3ff;
  color: #7c3aed;
}

.stat-icon.green {
  background: #ecfdf3;
  color: #16a34a;
}

.stat-label {
  display: block;

  margin-bottom: 3px;

  color: #98a2b3;

  font-size: 8px;
  font-weight: 850;

  letter-spacing: 1px;
}

.stat-card strong {
  color: #101828;

  font-size: 16px;
  font-weight: 850;
}


/* =========================================================
   CONTACTS PANEL
========================================================= */

.contacts-panel {
  padding: 26px;

  border: 1px solid #e7ebf1;
  border-radius: 22px;

  background: rgba(255, 255, 255, 0.8);

  -webkit-backdrop-filter: blur(20px);
  backdrop-filter: blur(20px);

  box-shadow:
    0 20px 50px rgba(15, 23, 42, 0.07);
}

.contacts-toolbar {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;

  margin-bottom: 18px;
}

.contacts-toolbar h2 {
  margin: 4px 0 0;

  color: #101828;

  font-size: 21px;
  font-weight: 850;

  letter-spacing: -0.3px;
}

.contact-total,
.contact-count {
  padding: 7px 13px;

  border: 1px solid #dbe3ff;
  border-radius: 999px;

  background: #f2f4f7;

  color: #667085;

  font-size: 9px;
  font-weight: 800;
}


/* =========================================================
   SEARCH
========================================================= */

.search-container {
  display: flex;

  gap: 9px;

  margin-bottom: 12px;
}

.search-box {
  position: relative;

  flex: 1;
}

.search-icon {
  position: absolute;

  left: 13px;
  top: 50%;

  transform: translateY(-50%);

  color: #98a2b3;

  font-size: 17px;

  pointer-events: none;
}

.search-box input {
  width: 100%;
  height: 46px;

  padding: 0 44px;

  border: 1px solid #dfe4eb;
  border-radius: 999px;

  outline: none;

  background: #fbfcfe;
  color: #101828;

  font-size: 12px;

  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease,
    background 0.2s ease;
}

.search-box input::placeholder {
  color: #98a2b3;
}

.search-box input:focus {
  background: #ffffff;

  border-color: #818cf8;

  box-shadow:
    0 0 0 4px rgba(99, 102, 241, 0.07);
}

.search-box input::-webkit-search-cancel-button {
  display: none;
}

.clear-search {
  position: absolute;

  right: 10px;
  top: 50%;

  transform: translateY(-50%);

  width: 22px;
  height: 22px;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 0;

  border: none;
  border-radius: 50%;

  background: #eef2f6;

  color: #667085;

  font-size: 15px;
  line-height: 1;
}

.clear-search:hover {
  background: #e4e9f0;
}

.search-button {
  height: 42px;

  padding: 0 17px;

  border: none;
  border-radius: 9px;

  background:
    linear-gradient(
      135deg,
      #2563eb,
      #4f46e5
    );

  color: #ffffff;

  font-size: 11px;
  font-weight: 800;

  box-shadow:
    0 7px 15px rgba(37, 99, 235, 0.13);

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease;
}

.search-button:hover {
  transform: translateY(-1px);

  box-shadow:
    0 10px 19px rgba(37, 99, 235, 0.19);
}

.search-info {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 12px;

  margin-bottom: 16px;
  padding: 8px 11px;

  border-radius: 8px;

  background: #f8faff;

  color: #667085;

  font-size: 10px;
}

.search-info button {
  padding: 0;

  border: none;

  background: transparent;

  color: #4f46e5;

  font-size: 10px;
  font-weight: 800;
}


/* =========================================================
   MODERN CONTACT CARDS
========================================================= */

.contacts {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 17px;
}

.contact-card-modern {
  position: relative;

  width: 100%;
  min-width: 0;

  padding: 22px;

  overflow: hidden;

  border: 1px solid #e5e9f0;
  border-radius: 20px;

  background:
    linear-gradient(
      180deg,
      #ffffff 0%,
      #fbfcff 100%
    );

  box-shadow:
    0 10px 26px rgba(15, 23, 42, 0.055);

  transition:
    transform 0.22s ease,
    box-shadow 0.22s ease,
    border-color 0.22s ease;
}

.contact-card-modern::before {
  content: "";

  position: absolute;

  left: 0;
  right: 0;
  top: 0;

  height: 4px;

  background:
    linear-gradient(
      90deg,
      #2563eb,
      #4f46e5,
      #7c3aed
    );
}

.contact-card-modern:hover {
  transform: translateY(-6px);

  border-color: #d7dcf2;

  box-shadow:
    0 22px 44px rgba(15, 23, 42, 0.11);
}


/* =========================================================
   CONTACT CARD HEADER
========================================================= */

.contact-card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  gap: 12px;
}

.profile-area {
  display: flex;
  align-items: center;

  gap: 13px;

  min-width: 0;
}

.large-avatar {
  width: 52px;
  height: 52px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  border-radius: 15px;

  background:
    linear-gradient(
      135deg,
      #2563eb,
      #6366f1
    );

  color: #ffffff;

  font-size: 14px;
  font-weight: 850;

  box-shadow:
    0 8px 17px rgba(37, 99, 235, 0.18);
}

.profile-details {
  min-width: 0;
}

.contact-number {
  display: block;

  margin-bottom: 4px;

  color: #98a2b3;

  font-size: 9px;
  font-weight: 850;

  letter-spacing: 1px;
}

.profile-details h2 {
  margin: 0;

  color: #101828;

  font-size: 20px;
  font-weight: 850;

  line-height: 1.35;

  letter-spacing: -0.2px;

  overflow-wrap: anywhere;
}

.contact-status {
  display: flex;
  align-items: center;

  gap: 5px;

  margin-top: 4px;

  color: #7a8494;

  font-size: 10px;
}

.contact-status .status-dot {
  width: 7px;
  height: 7px;

  flex-shrink: 0;

  border-radius: 50%;

  background: #22c55e;

  box-shadow:
    0 0 0 3px rgba(34, 197, 94, 0.08);
}


/* =========================================================
   CONTACT CARD MORE BUTTON
========================================================= */

.more-button {
  width: 34px;
  height: 34px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  padding: 0;

  border: 1px solid #e7ebf1;
  border-radius: 8px;

  background: #ffffff;

  color: #667085;

  font-size: 19px;
  line-height: 1;

  transition:
    background 0.18s ease,
    color 0.18s ease,
    border-color 0.18s ease;
}

.more-button:hover {
  background: #f4f6ff;

  border-color: #cfd6f7;

  color: #4338ca;
}


/* =========================================================
   CONTACT INFORMATION
========================================================= */

.contact-details-list {
  display: flex;
  flex-direction: column;

  gap: 13px;

  margin-top: 21px;
}

.detail-row {
  display: flex;
  align-items: center;

  gap: 11px;

  min-width: 0;
}

.detail-icon {
  width: 37px;
  height: 37px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  border-radius: 9px;

  font-size: 13px;
  font-weight: 800;
}

.phone-detail {
  background: #eff6ff;
  color: #2563eb;
}

.email-detail {
  background: #f5f3ff;
  color: #7c3aed;
}

.address-detail {
  background: #ecfdf3;
  color: #16a34a;
}

.detail-content {
  min-width: 0;
}

.detail-content span {
  display: block;

  margin-bottom: 2px;

  color: #a0a9b7;

  font-size: 8px;
  font-weight: 850;

  letter-spacing: 0.8px;
}

.detail-content strong {
  display: block;

  min-width: 0;

  color: #475467;

  font-size: 13px;
  font-weight: 650;

  line-height: 1.45;

  overflow-wrap: anywhere;
  word-break: break-word;
}

.detail-content .address-text {
  display: -webkit-box;

  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;

  overflow: hidden;
}


/* =========================================================
   CONTACT CARD ACTIONS
========================================================= */

.card-divider {
  height: 1px;

  margin: 19px 0 15px;

  background: #edf0f4;
}

.modern-card-actions {
  display: flex;

  gap: 8px;
}

.modern-card-actions button {
  flex: 1;

  min-height: 40px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  gap: 6px;

  border-radius: 9px;

  font-size: 11px;
  font-weight: 800;

  transition:
    transform 0.18s ease,
    background 0.18s ease,
    box-shadow 0.18s ease;
}

.modern-card-actions button:hover {
  transform: translateY(-1px);
}

.edit-contact-button {
  border: 1px solid #dfe4ff;

  background: #f0f3ff;

  color: #4338ca;
}

.edit-contact-button:hover {
  background: #e6eaff;

  box-shadow:
    0 5px 12px rgba(67, 56, 202, 0.08);
}

.delete-contact-button {
  border: 1px solid #ffe0e4;

  background: #fff5f6;

  color: #be123c;
}

.delete-contact-button:hover {
  background: #ffecee;

  box-shadow:
    0 5px 12px rgba(190, 18, 60, 0.07);
}


/* =========================================================
   EMPTY / ERROR / LOADING
========================================================= */

.message {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  min-height: 260px;

  padding: 30px;

  text-align: center;

  border: 1px solid #e8ecf2;
  border-radius: 14px;

  background: #ffffff;

  box-shadow:
    0 6px 18px rgba(15, 23, 42, 0.025);
}

.message h2 {
  margin: 0 0 7px;

  color: #101828;

  font-size: 19px;
  font-weight: 850;
}

.message p {
  max-width: 400px;

  margin: 0 0 17px;

  color: #7a8494;

  font-size: 11px;

  line-height: 1.6;
}

.message.empty {
  border-style: dashed;

  box-shadow: none;
}

.message.error {
  border-color: #fecdd3;

  background: #fff8f9;
}

.empty-icon {
  width: 56px;
  height: 56px;

  display: flex;
  align-items: center;
  justify-content: center;

  margin-bottom: 14px;

  border-radius: 16px;

  background:
    linear-gradient(
      135deg,
      #eff6ff,
      #eef2ff
    );

  color: #4f46e5;

  font-size: 21px;
  font-weight: 850;
}

.primary-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  min-height: 38px;

  padding: 0 15px;

  border: none;
  border-radius: 9px;

  background:
    linear-gradient(
      135deg,
      #2563eb,
      #4f46e5
    );

  color: #ffffff;

  font-size: 10px;
  font-weight: 800;

  box-shadow:
    0 7px 15px rgba(37, 99, 235, 0.13);

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease;
}

.primary-button:hover {
  transform: translateY(-1px);

  box-shadow:
    0 10px 19px rgba(37, 99, 235, 0.19);
}

.loading-state {
  border: none;

  box-shadow: none;
}

.loading-spinner {
  width: 30px;
  height: 30px;

  margin-bottom: 10px;

  border: 3px solid #e6eaf0;
  border-top-color: #4f46e5;

  border-radius: 50%;

  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}


/* =========================================================
   PAGINATION
========================================================= */

.pagination {
  display: flex;
  align-items: center;
  justify-content: center;

  gap: 8px;

  margin-top: 26px;
  padding-top: 20px;

  border-top: 1px solid #edf0f4;
}

.pagination-button,
.page-number {
  height: 35px;

  border-radius: 8px;

  font-size: 10px;
  font-weight: 750;

  transition:
    background 0.18s ease,
    border-color 0.18s ease,
    color 0.18s ease,
    transform 0.18s ease;
}

.pagination-button {
  padding: 0 12px;

  border: 1px solid #dde3eb;

  background: #ffffff;

  color: #475467;
}

.pagination-button:hover:not(:disabled) {
  transform: translateY(-1px);

  background: #f8fafc;

  border-color: #cbd5e1;
}

.pagination-button:disabled {
  opacity: 0.4;

  cursor: not-allowed;
}

.page-numbers {
  display: flex;

  gap: 5px;
}

.page-number {
  width: 35px;

  padding: 0;

  border: 1px solid #dde3eb;

  background: #ffffff;

  color: #667085;
}

.page-number:hover {
  background: #f8fafc;

  border-color: #cbd5e1;
}

.page-number.active {
  border-color: #4f46e5;

  background:
    linear-gradient(
      135deg,
      #2563eb,
      #4f46e5
    );

  color: #ffffff;

  box-shadow:
    0 5px 12px rgba(79, 70, 229, 0.18);
}


/* =========================================================
   FORM PAGES
========================================================= */

.create-contact-page,
.contact-detail {
  width: 100%;
  max-width: 900px;

  margin: 0 auto;

  padding: 0;
}

.page-header {
  position: relative;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 20px;

  margin-bottom: 24px;

  padding: 26px 28px;

  overflow: hidden;

  border: 1px solid #e8ecf2;
  border-radius: 18px;

  background: #ffffff;

  box-shadow:
    0 8px 28px rgba(15, 23, 42, 0.035);
}

.page-header::after {
  content: "";

  position: absolute;

  width: 190px;
  height: 190px;

  top: -105px;
  right: -65px;

  border-radius: 50%;

  background:
    linear-gradient(
      135deg,
      rgba(59, 130, 246, 0.1),
      rgba(99, 102, 241, 0.02)
    );
}

.page-header h1 {
  position: relative;
  z-index: 1;

  margin: 5px 0 0;

  color: #101828;

  font-size: 27px;
  line-height: 1.15;
  font-weight: 850;

  letter-spacing: -0.6px;
}

.page-header p {
  position: relative;
  z-index: 1;

  margin: 7px 0 0;

  color: #7a8494;

  font-size: 12px;
}


/* =========================================================
   BACK BUTTON
========================================================= */

.back-button {
  position: relative;
  z-index: 5;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  gap: 8px;

  min-width: 100px;
  height: 42px;

  padding: 0 17px;

  border: 1px solid #d9deea;
  border-radius: 10px;

  background: #ffffff;

  color: #344054;

  font-size: 13px;
  font-weight: 750;

  box-shadow:
    0 3px 10px rgba(15, 23, 42, 0.05);

  transition:
    background 0.2s ease,
    border-color 0.2s ease,
    color 0.2s ease,
    transform 0.2s ease,
    box-shadow 0.2s ease;
}

.back-button:hover {
  transform: translateY(-2px);

  background: #f8faff;

  border-color: #c7d2fe;

  color: #4338ca;

  box-shadow:
    0 7px 16px rgba(15, 23, 42, 0.08);
}

.back-button:active {
  transform: translateY(0);
}

.back-button:focus-visible {
  outline: 3px solid rgba(99, 102, 241, 0.18);
  outline-offset: 2px;
}

.back-arrow {
  font-size: 17px;
  line-height: 1;
}


/* =========================================================
   FORMS
========================================================= */

.contact-form,
.detail-form {
  width: 100%;
  max-width: 700px;

  margin: 0 auto;

  padding: 32px;

  border: 1px solid #e7ebf1;
  border-radius: 22px;

  background: rgba(255, 255, 255, 0.8);

  -webkit-backdrop-filter: blur(20px);
  backdrop-filter: blur(20px);

  box-shadow:
    0 18px 46px rgba(15, 23, 42, 0.07);
}

.contact-form h2,
.detail-form h2 {
  margin: 0;

  color: #101828;

  font-size: 21px;
  font-weight: 850;
}

.form-title {
  display: flex;
  align-items: center;

  gap: 12px;

  margin-bottom: 25px;

  padding-bottom: 20px;

  border-bottom: 1px solid #edf0f4;
}

.form-title p {
  margin: 4px 0 0;

  color: #8a94a4;

  font-size: 11px;
}

.edit-icon {
  width: 41px;
  height: 41px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  border-radius: 11px;

  background: #eef2ff;

  color: #4f46e5;

  font-size: 17px;
}

.form-group {
  margin-bottom: 17px;
}

.form-group label {
  display: block;

  margin-bottom: 7px;

  color: #344054;

  font-size: 11px;
  font-weight: 750;
}

.form-group label span {
  color: #ef4444;
}

.form-group input,
.form-group textarea {
  width: 100%;

  padding: 13px 15px;

  border: 1px solid #d9dee7;
  border-radius: 12px;

  outline: none;

  background: #fbfcfe;

  color: #101828;

  font-size: 12px;

  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease,
    background 0.2s ease;
}

.form-group input::placeholder,
.form-group textarea::placeholder {
  color: #a0a9b7;
}

.form-group input:focus,
.form-group textarea:focus {
  background: #ffffff;

  border-color: #818cf8;

  box-shadow:
    0 0 0 4px rgba(99, 102, 241, 0.07);
}

.form-group textarea {
  min-height: 105px;

  resize: vertical;
}

.contact-form button[type="submit"],
.detail-form button[type="submit"] {
  width: 100%;

  min-height: 42px;

  border: none;
  border-radius: 9px;

  background:
    linear-gradient(
      135deg,
      #2563eb,
      #4f46e5
    );

  color: #ffffff;

  font-size: 11px;
  font-weight: 800;

  box-shadow:
    0 8px 18px rgba(37, 99, 235, 0.14);

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease;
}

.contact-form button[type="submit"]:hover,
.detail-form button[type="submit"]:hover {
  transform: translateY(-1px);

  box-shadow:
    0 11px 22px rgba(37, 99, 235, 0.21);
}

.contact-form button:disabled,
.detail-form button:disabled {
  opacity: 0.55;

  cursor: not-allowed;

  transform: none;
}


/* =========================================================
   FORM ACTIONS
========================================================= */

.form-actions {
  display: flex;

  gap: 9px;

  margin-top: 22px;

  padding-top: 20px;

  border-top: 1px solid #edf0f4;
}

.form-actions button {
  min-height: 42px;

  border-radius: 11px;

  font-size: 10px;
  font-weight: 800;
}

.secondary-button {
  flex: 0 0 115px;

  border: 1px solid #dfe4ec;

  background: #ffffff;

  color: #475467;

  transition:
    background 0.2s ease,
    transform 0.2s ease;
}

.secondary-button:hover {
  transform: translateY(-1px);

  background: #f8fafc;
}

.save-button {
  flex: 1;

  border: none;

  background:
    linear-gradient(
      135deg,
      #2563eb,
      #4f46e5
    );

  color: #ffffff;

  box-shadow:
    0 8px 18px rgba(37, 99, 235, 0.14);

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease;
}

.save-button:hover {
  transform: translateY(-1px);

  box-shadow:
    0 11px 22px rgba(37, 99, 235, 0.21);
}


/* =========================================================
   FORM ERROR
========================================================= */

.form-error {
  margin-bottom: 15px;

  padding: 10px 12px;

  border: 1px solid #fecdd3;
  border-radius: 8px;

  background: #fff1f2;

  color: #be123c;

  font-size: 10px;

  line-height: 1.5;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 1050px) {
  .contacts {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 850px) {
  .sidebar {
    transform: translateX(-120%);

    transition:
      transform 0.25s ease;
  }

  .sidebar.sidebar-open {
    transform: translateX(0);
  }

  .sidebar-overlay {
    position: fixed;
    inset: 0;

    display: block;

    background: rgba(15, 23, 42, 0.42);

    z-index: 90;
  }

  .mobile-close {
    display: block;
  }

  .mobile-menu {
    width: 36px;
    height: 36px;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 0;

    border: 1px solid #e0e5ec;
    border-radius: 12px;

    background: #ffffff;

    color: #475467;

    font-size: 16px;
  }

  .main-content {
    margin-left: 0;

    padding: 12px;
  }

  .topbar {
    top: 12px;

    padding: 0 18px;
  }

  .topbar::before {
    top: -13px;
    height: 13px;
  }

  .page-container {
    padding: 20px 4px 30px;
  }

  .stats-row {
    grid-template-columns:
      repeat(3, minmax(0, 1fr));
  }
}

@media (max-width: 700px) {
  .contacts {
    grid-template-columns: 1fr;
  }

  .stats-row {
    grid-template-columns: 1fr;
  }

  .dashboard-heading {
    align-items: flex-start;

    flex-direction: column;
  }

  .dashboard-date {
    align-self: stretch;

    justify-content: space-between;
  }
}

@media (max-width: 620px) {
  .topbar {
    padding: 0 16px;
  }

  .topbar-action span:last-child {
    display: none;
  }

  .topbar-action {
    width: 38px;

    padding: 0;
  }

  .topbar-breadcrumb {
    flex: 1;

    justify-content: center;
  }

  .page-container {
    padding: 16px 2px 28px;
  }

  .contacts-panel {
    padding: 17px;
  }

  .search-container {
    flex-direction: column;
  }

  .search-button {
    width: 100%;
  }

  .section-heading,
  .contacts-toolbar {
    align-items: flex-start;
  }

  .pagination {
    flex-wrap: wrap;
  }

  .page-numbers {
    width: 100%;

    order: -1;

    justify-content: center;
  }

  .page-header {
    align-items: flex-start;

    padding: 21px;

    flex-direction: column;
  }

  .page-header .back-button {
    width: 100%;
  }

  .contact-form,
  .detail-form {
    padding: 22px;
  }

  .form-actions {
    flex-direction: column;
  }

  .secondary-button,
  .save-button {
    width: 100%;

    flex: auto;
  }

  .contact-card-modern {
    padding: 19px;
  }

  .large-avatar {
    width: 47px;
    height: 47px;
  }

  .profile-details h2 {
    font-size: 18px;
  }

  .detail-content strong {
    font-size: 12px;
  }

  .modern-card-actions {
    flex-direction: column;
  }
}
/* =========================================================
   PAGE SELECTOR
========================================================= */

.page-selector {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;

  color: #667085;

  font-size: 10px;
  font-weight: 700;
}

.page-selector select {
  min-width: 58px;
  height: 35px;

  padding: 0 25px 0 10px;

  border: 1px solid #dde3eb;
  border-radius: 8px;

  outline: none;

  background: #ffffff;
  color: #344054;

  font-size: 10px;
  font-weight: 800;

  cursor: pointer;

  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}

.page-selector select:hover {
  border-color: #cbd5e1;
}

.page-selector select:focus {
  border-color: #818cf8;

  box-shadow:
    0 0 0 3px rgba(99, 102, 241, 0.08);
}
/* =========================================================
   LANDING PAGE
========================================================= */

.landing-page {
  position: relative;

  min-height: 100vh;

  display: flex;
  align-items: center;
  justify-content: center;

  overflow: hidden;

  background:
    linear-gradient(
      135deg,
      #08101f 0%,
      #101827 45%,
      #15142b 100%
    );

  color: #ffffff;
}

.landing-background {
  position: absolute;
  inset: 0;

  overflow: hidden;

  pointer-events: none;
}


/* Background glows */

.landing-glow {
  position: absolute;

  border-radius: 50%;

  filter: blur(10px);
}

.glow-one {
  width: 420px;
  height: 420px;

  top: -190px;
  right: -100px;

  background:
    radial-gradient(
      circle,
      rgba(59, 130, 246, 0.24),
      rgba(59, 130, 246, 0)
    );
}

.glow-two {
  width: 500px;
  height: 500px;

  left: -230px;
  bottom: -260px;

  background:
    radial-gradient(
      circle,
      rgba(124, 58, 237, 0.22),
      rgba(124, 58, 237, 0)
    );
}


/* Subtle grid */

.landing-grid {
  position: absolute;
  inset: 0;

  opacity: 0.16;

  background-image:
    linear-gradient(
      rgba(255, 255, 255, 0.045) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.045) 1px,
      transparent 1px
    );

  background-size:
    48px 48px;

  mask-image:
    linear-gradient(
      to bottom,
      black,
      transparent 90%
    );
}


/* Main content */

.landing-content {
  position: relative;
  z-index: 2;

  width: min(100%, 1080px);

  min-height: 100vh;

  display: flex;
  flex-direction: column;

  padding: 42px 44px;

  margin: 0 auto;
}


/* Brand */

.landing-brand {
  display: flex;
  align-items: center;

  gap: 13px;
}

.landing-logo {
  width: 48px;
  height: 48px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 14px;

  background:
    linear-gradient(
      135deg,
      #3b82f6,
      #6366f1
    );

  box-shadow:
    0 12px 30px rgba(59, 130, 246, 0.28);
}

.landing-logo span {
  font-size: 22px;
  line-height: 1;
}

.landing-brand h1 {
  margin: 0;

  color: #ffffff;

  font-size: 18px;
  font-weight: 850;

  letter-spacing: -0.3px;
}

.landing-brand p {
  margin: 3px 0 0;

  color: #8190a6;

  font-size: 10px;
}


/* Main */

.landing-main {
  width: min(100%, 720px);

  margin: auto 0;

  padding: 70px 0;
}

.landing-badge {
  display: inline-flex;
  align-items: center;

  padding: 7px 11px;

  border: 1px solid rgba(147, 197, 253, 0.13);
  border-radius: 999px;

  background:
    rgba(59, 130, 246, 0.07);

  color: #9db7e8;

  font-size: 8px;
  font-weight: 800;

  letter-spacing: 1px;
}

.landing-main h2 {
  max-width: 720px;

  margin: 22px 0 0;

  color: #ffffff;

  font-size: clamp(44px, 6vw, 76px);

  line-height: 0.98;

  font-weight: 850;

  letter-spacing: -3px;
}

.landing-main h2 span {
  display: block;

  background:
    linear-gradient(
      90deg,
      #60a5fa,
      #818cf8,
      #a78bfa
    );

  -webkit-background-clip: text;
  background-clip: text;

  color: transparent;
}

.landing-description {
  max-width: 570px;

  margin: 24px 0 0;

  color: #95a1b3;

  font-size: 14px;

  line-height: 1.75;
}


/* CTA */

.landing-button {
  display: inline-flex;
  align-items: center;

  gap: 14px;

  margin-top: 32px;

  min-height: 50px;

  padding: 0 19px;

  border: 1px solid rgba(147, 197, 253, 0.2);
  border-radius: 12px;

  background:
    linear-gradient(
      135deg,
      #2563eb,
      #4f46e5
    );

  color: #ffffff;

  font-size: 12px;
  font-weight: 800;

  box-shadow:
    0 14px 30px rgba(37, 99, 235, 0.24);

  transition:
    transform 0.22s ease,
    box-shadow 0.22s ease;
}

.landing-button:hover {
  transform: translateY(-3px);

  box-shadow:
    0 19px 36px rgba(37, 99, 235, 0.32);
}

.landing-arrow {
  font-size: 18px;

  transition:
    transform 0.22s ease;
}

.landing-button:hover .landing-arrow {
  transform: translateX(3px);
}


/* Features */

.landing-features {
  display: flex;

  gap: 30px;

  margin-top: 55px;
}

.landing-feature {
  display: flex;
  align-items: center;

  gap: 10px;
}

.feature-icon {
  width: 34px;
  height: 34px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 9px;

  background:
    rgba(255, 255, 255, 0.055);

  border: 1px solid rgba(255, 255, 255, 0.07);

  font-size: 13px;
}

.landing-feature strong {
  display: block;

  color: #e8edf5;

  font-size: 10px;
  font-weight: 800;
}

.landing-feature span {
  display: block;

  margin-top: 2px;

  color: #718096;

  font-size: 8px;
}


/* Footer */

.landing-footer {
  display: flex;
  align-items: center;

  gap: 9px;

  color: #68778d;

  font-size: 8px;
}

.footer-dot {
  width: 5px;
  height: 5px;

  border-radius: 50%;

  background: #22c55e;

  box-shadow:
    0 0 0 3px rgba(34, 197, 94, 0.08);
}


/* =========================================================
   LANDING RESPONSIVE
========================================================= */

@media (max-width: 700px) {
  .landing-content {
    padding: 28px 22px;
  }

  .landing-main {
    padding: 55px 0;
  }

  .landing-main h2 {
    font-size: clamp(40px, 13vw, 58px);

    letter-spacing: -2px;
  }

  .landing-description {
    font-size: 13px;
  }

  .landing-features {
    flex-direction: column;

    gap: 14px;

    margin-top: 40px;
  }
}

@media (max-width: 480px) {
  .landing-content {
    padding: 23px 18px;
  }

  .landing-logo {
    width: 43px;
    height: 43px;
  }

  .landing-main {
    padding: 40px 0;
  }

  .landing-main h2 {
    font-size: 39px;
  }

  .landing-button {
    width: 100%;

    justify-content: center;
  }

  .landing-footer {
    flex-wrap: wrap;
  }
}
/* =========================================================
   PREMIUM COVER PAGE
========================================================= */

.landing-page {
  position: relative;

  min-height: 100vh;

  overflow: hidden;

  background:
    linear-gradient(
      135deg,
      #07101e 0%,
      #0d1728 45%,
      #16132d 100%
    );

  color: #ffffff;
}

.landing-background {
  position: absolute;
  inset: 0;

  overflow: hidden;

  pointer-events: none;
}

.landing-orb {
  position: absolute;

  border-radius: 50%;

  filter: blur(4px);
}

.orb-one {
  width: 520px;
  height: 520px;

  top: -280px;
  right: -120px;

  background:
    radial-gradient(
      circle,
      rgba(37, 99, 235, 0.28),
      transparent 68%
    );
}

.orb-two {
  width: 600px;
  height: 600px;

  bottom: -360px;
  left: -270px;

  background:
    radial-gradient(
      circle,
      rgba(124, 58, 237, 0.24),
      transparent 68%
    );
}

.orb-three {
  width: 360px;
  height: 360px;

  top: 35%;
  left: 48%;

  background:
    radial-gradient(
      circle,
      rgba(59, 130, 246, 0.08),
      transparent 70%
    );
}

.landing-grid {
  position: absolute;
  inset: 0;

  opacity: 0.14;

  background-image:
    linear-gradient(
      rgba(255, 255, 255, 0.045) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.045) 1px,
      transparent 1px
    );

  background-size: 52px 52px;

  mask-image:
    linear-gradient(
      to bottom,
      black 0%,
      rgba(0, 0, 0, 0.5) 55%,
      transparent 100%
    );
}

.landing-content {
  position: relative;
  z-index: 2;

  width: min(1180px, 100%);

  min-height: 100vh;

  margin: 0 auto;

  padding: 30px 46px 24px;

  display: flex;
  flex-direction: column;
}


/* =========================================================
   HEADER
========================================================= */

.landing-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.landing-brand {
  display: flex;
  align-items: center;

  gap: 12px;
}

.landing-logo {
  width: 46px;
  height: 46px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 14px;

  background:
    linear-gradient(
      135deg,
      #2563eb,
      #6366f1
    );

  box-shadow:
    0 10px 25px rgba(37, 99, 235, 0.28);
}

.landing-logo span {
  font-size: 21px;

  line-height: 1;
}

.landing-brand-text strong {
  display: block;

  color: #ffffff;

  font-size: 17px;
  font-weight: 850;
}

.landing-brand-text span {
  display: block;

  margin-top: 1px;

  color: #718096;

  font-size: 9px;
}

.landing-header-status {
  display: flex;
  align-items: center;

  gap: 7px;

  padding: 7px 10px;

  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 999px;

  background:
    rgba(255, 255, 255, 0.035);

  color: #8793a7;

  font-size: 9px;
}

.landing-status-dot {
  width: 6px;
  height: 6px;

  border-radius: 50%;

  background: #22c55e;

  box-shadow:
    0 0 0 4px rgba(34, 197, 94, 0.08);
}


/* =========================================================
   HERO
========================================================= */

.landing-hero {
  width: min(720px, 100%);

  margin: auto 0;

  padding: 55px 0 35px;
}

.landing-badge {
  display: inline-flex;
  align-items: center;

  gap: 7px;

  padding: 8px 11px;

  border: 1px solid rgba(129, 140, 248, 0.18);
  border-radius: 999px;

  background:
    rgba(99, 102, 241, 0.07);

  color: #9da8c1;

  font-size: 8px;
  font-weight: 800;

  letter-spacing: 1.1px;
}

.badge-spark {
  color: #818cf8;

  font-size: 10px;
}

.landing-hero h1 {
  margin: 22px 0 0;

  color: #ffffff;

  font-size: clamp(48px, 6vw, 75px);

  line-height: 0.98;

  font-weight: 850;

  letter-spacing: -3.5px;
}

.landing-hero h1 span {
  display: block;

  background:
    linear-gradient(
      90deg,
      #60a5fa,
      #818cf8,
      #a78bfa
    );

  -webkit-background-clip: text;
  background-clip: text;

  color: transparent;
}

.landing-description {
  max-width: 590px;

  margin: 25px 0 0;

  color: #97a3b6;

  font-size: 14px;

  line-height: 1.75;
}


/* =========================================================
   CTA
========================================================= */

.landing-cta {
  width: fit-content;

  min-width: 255px;

  display: inline-flex;
  align-items: center;

  gap: 12px;

  margin-top: 32px;

  padding: 9px 11px;

  border: 1px solid rgba(147, 197, 253, 0.18);
  border-radius: 13px;

  background:
    linear-gradient(
      135deg,
      #2563eb,
      #4f46e5
    );

  color: #ffffff;

  box-shadow:
    0 15px 32px rgba(37, 99, 235, 0.25);

  transition:
    transform 0.22s ease,
    box-shadow 0.22s ease;
}

.landing-cta:hover {
  transform: translateY(-3px);

  box-shadow:
    0 20px 40px rgba(37, 99, 235, 0.34);
}

.cta-icon {
  width: 34px;
  height: 34px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 9px;

  background:
    rgba(255, 255, 255, 0.12);

  font-size: 17px;
}

.cta-text {
  display: flex;
  flex-direction: column;

  flex: 1;
}

.cta-text strong {
  font-size: 11px;
  font-weight: 850;
}

.cta-text small {
  margin-top: 2px;

  color: rgba(255, 255, 255, 0.66);

  font-size: 8px;
}

.cta-arrow {
  font-size: 18px;

  transition:
    transform 0.2s ease;
}

.landing-cta:hover .cta-arrow {
  transform: translateX(3px);
}


/* =========================================================
   FEATURE PILLS
========================================================= */

.landing-features {
  display: flex;

  flex-wrap: wrap;

  gap: 10px;

  margin-top: 26px;
}

.landing-feature {
  display: inline-flex;
  align-items: center;

  gap: 7px;

  padding: 8px 10px;

  border: 1px solid rgba(255, 255, 255, 0.07);
  border-radius: 8px;

  background:
    rgba(255, 255, 255, 0.035);

  color: #8995a9;

  font-size: 9px;
}

.feature-check {
  width: 15px;
  height: 15px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background:
    rgba(34, 197, 94, 0.11);

  color: #4ade80;

  font-size: 8px;
  font-weight: 800;
}


/* =========================================================
   PREVIEW WINDOW
========================================================= */

.landing-preview {
  position: absolute;

  right: 46px;
  top: 50%;

  width: 360px;

  transform:
    translateY(-45%);

  opacity: 0.96;
}

.preview-window {
  overflow: hidden;

  border: 1px solid rgba(255, 255, 255, 0.1);

  border-radius: 19px;

  background:
    rgba(255, 255, 255, 0.055);

  box-shadow:
    0 28px 70px rgba(0, 0, 0, 0.35);

  backdrop-filter: blur(16px);

  transform:
    perspective(1200px)
    rotateY(-7deg)
    rotateX(2deg);

  transition:
    transform 0.35s ease;
}

.preview-window:hover {
  transform:
    perspective(1200px)
    rotateY(-3deg)
    rotateX(1deg)
    translateY(-4px);
}

.preview-topbar {
  height: 40px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 13px;

  border-bottom:
    1px solid rgba(255, 255, 255, 0.07);

  background:
    rgba(255, 255, 255, 0.025);
}

.preview-dots {
  display: flex;

  gap: 5px;
}

.preview-dots span {
  width: 6px;
  height: 6px;

  border-radius: 50%;

  background: #5b6779;
}

.preview-title {
  color: #8c98aa;

  font-size: 7px;
  font-weight: 850;

  letter-spacing: 1px;
}

.preview-placeholder {
  width: 28px;
}

.preview-body {
  padding: 19px;
}

.preview-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.preview-heading small {
  display: block;

  color: #69758a;

  font-size: 7px;
  font-weight: 800;

  letter-spacing: 0.9px;
}

.preview-heading strong {
  display: block;

  margin-top: 4px;

  color: #eef2f7;

  font-size: 15px;
}

.preview-count {
  color: #707d91;

  font-size: 7px;
}

.preview-search {
  display: flex;
  align-items: center;

  gap: 7px;

  height: 33px;

  margin-top: 16px;

  padding: 0 10px;

  border:
    1px solid rgba(255, 255, 255, 0.07);

  border-radius: 8px;

  background:
    rgba(255, 255, 255, 0.035);

  color: #687589;

  font-size: 9px;
}

.preview-search span {
  color: #8a96a8;

  font-size: 13px;
}

.preview-cards {
  display: flex;
  flex-direction: column;

  gap: 8px;

  margin-top: 13px;
}

.preview-card {
  display: flex;
  align-items: center;

  gap: 9px;

  padding: 9px;

  border:
    1px solid rgba(255, 255, 255, 0.06);

  border-radius: 9px;

  background:
    rgba(255, 255, 255, 0.025);
}

.preview-avatar {
  width: 30px;
  height: 30px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  border-radius: 9px;

  background:
    linear-gradient(
      135deg,
      #2563eb,
      #6366f1
    );

  color: #ffffff;

  font-size: 8px;
  font-weight: 850;
}

.preview-avatar.second {
  background:
    linear-gradient(
      135deg,
      #7c3aed,
      #a855f7
    );
}

.preview-avatar.third {
  background:
    linear-gradient(
      135deg,
      #0f766e,
      #14b8a6
    );
}

.preview-card strong {
  display: block;

  color: #e5eaf1;

  font-size: 9px;
}

.preview-card span {
  display: block;

  margin-top: 2px;

  color: #687589;

  font-size: 7px;
}


/* =========================================================
   FOOTER
========================================================= */

.landing-footer {
  display: flex;
  align-items: center;

  gap: 8px;

  margin-top: auto;

  color: #5e6b7f;

  font-size: 8px;
}

.footer-separator {
  color: #3d485a;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 1050px) {
  .landing-preview {
    position: relative;

    top: auto;
    right: auto;

    width: min(500px, 100%);

    margin: 0 auto 30px;

    transform: none;

    opacity: 1;
  }

  .preview-window {
    transform: none;
  }

  .landing-content {
    padding-bottom: 30px;
  }

  .landing-hero {
    margin: 70px 0 35px;
  }
}

@media (max-width: 700px) {
  .landing-content {
    padding: 24px 20px;
  }

  .landing-header-status {
    display: none;
  }

  .landing-hero {
    margin: 55px 0 30px;

    padding: 0;
  }

  .landing-hero h1 {
    font-size: clamp(42px, 12vw, 58px);

    letter-spacing: -2.5px;
  }

  .landing-description {
    font-size: 13px;
  }

  .landing-cta {
    width: 100%;
  }

  .landing-features {
    flex-direction: column;
    align-items: flex-start;
  }

  .landing-preview {
    width: 100%;
  }
}

@media (max-width: 480px) {
  .landing-content {
    padding: 20px 16px;
  }

  .landing-logo {
    width: 42px;
    height: 42px;
  }

  .landing-brand-text strong {
    font-size: 16px;
  }

  .landing-main {
    padding-top: 30px;
  }

  .landing-hero h1 {
    font-size: 39px;
  }

  .landing-badge {
    font-size: 7px;
  }

  .landing-description {
    font-size: 12px;
  }

  .preview-body {
    padding: 15px;
  }

  .landing-footer {
    font-size: 7px;
  }
}
.page-selector {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;

  color: #667085;

  font-size: 10px;
  font-weight: 700;
}

.page-selector select {
  min-width: 60px;
  height: 35px;

  padding: 0 9px;

  border: 1px solid #dde3eb;
  border-radius: 8px;

  outline: none;

  background: #ffffff;
  color: #344054;

  font-size: 10px;
  font-weight: 800;

  cursor: pointer;
}

.page-selector select:focus {
  border-color: #818cf8;

  box-shadow:
    0 0 0 3px rgba(99, 102, 241, 0.08);
}

.pagination-info {
  margin-top: 12px;

  text-align: center;

  color: #98a2b3;

  font-size: 10px;
}

.pagination-info strong {
  color: #475467;
  font-weight: 800;
}

@media (max-width: 620px) {
  .page-selector {
    width: 100%;
    order: -1;
  }
}
.form-group select {
  width: 100%;

  padding: 13px 15px;

  border: 1px solid #d9dee7;
  border-radius: 12px;

  outline: none;

  background: #fbfcfe;
  color: #101828;

  font-size: 12px;

  cursor: pointer;

  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease,
    background 0.2s ease;
}

.form-group select:focus {
  background: #ffffff;

  border-color: #818cf8;

  box-shadow:
    0 0 0 4px rgba(99, 102, 241, 0.07);
}
/* =========================================================
   CONTACT CATEGORY
========================================================= */

.contact-category {
  display: inline-flex;
  align-items: center;

  width: fit-content;

  margin-bottom: 5px;

  padding: 4px 9px;

  border-radius: 999px;

  font-size: 8px;
  font-weight: 850;

  line-height: 1;

  letter-spacing: 0.7px;

  text-transform: uppercase;
}

.category-work {
  background: #eff6ff;
  color: #2563eb;
}

.category-family {
  background: #fff7ed;
  color: #c2410c;
}

.category-friend {
  background: #ecfdf3;
  color: #15803d;
}


/* =========================================================
   CONTACT LINKS
========================================================= */

.contact-link {
  color: inherit;

  text-decoration: none;
}

.contact-link:hover {
  color: #4338ca;

  text-decoration: underline;
}


/* =========================================================
   EDIT LINK
========================================================= */

.edit-contact-button {
  flex: 1;

  min-height: 40px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  gap: 6px;

  padding: 0 10px;

  border: 1px solid #dfe4ff;
  border-radius: 9px;

  background: #f0f3ff;
  color: #4338ca;

  font-size: 11px;
  font-weight: 800;

  text-decoration: none;

  transition:
    transform 0.18s ease,
    background 0.18s ease,
    box-shadow 0.18s ease;
}

.edit-contact-button:hover {
  transform: translateY(-1px);

  background: #e6eaff;

  box-shadow:
    0 5px 12px rgba(67, 56, 202, 0.08);
}


/* =========================================================
   CATEGORY MOBILE
========================================================= */

@media (max-width: 620px) {
  .contact-category {
    font-size: 7px;
  }
}
.form-group select {
  width: 100%;

  box-sizing: border-box;

  padding: 13px 15px;

  border: 1px solid #d9dee7;
  border-radius: 12px;

  outline: none;

  background: #fbfcfe;
  color: #101828;

  font-size: 12px;

  cursor: pointer;

  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease,
    background 0.2s ease;
}

.form-group select:hover {
  border-color: #cbd5e1;
}

.form-group select:focus {
  background: #ffffff;

  border-color: #818cf8;

  box-shadow:
    0 0 0 4px rgba(99, 102, 241, 0.07);
}

.form-success {
  margin-bottom: 18px;

  padding: 11px 13px;

  border: 1px solid #bbf7d0;
  border-radius: 9px;

  background: #f0fdf4;

  color: #15803d;

  font-size: 11px;
  font-weight: 700;
}

.form-error {
  margin-bottom: 18px;

  padding: 11px 13px;

  border: 1px solid #fecdd3;
  border-radius: 9px;

  background: #fff8f9;

  color: #be123c;

  font-size: 11px;
  font-weight: 700;
}
/* =========================================================
   CATEGORY TABS
========================================================= */

.category-tabs {
  display: flex;

  gap: 8px;

  margin-bottom: 16px;

  padding-bottom: 2px;

  overflow-x: auto;
}

.category-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  gap: 7px;

  min-height: 36px;

  padding: 0 13px;

  border: 1px solid #e1e6ee;
  border-radius: 9px;

  background: #ffffff;

  color: #667085;

  font-size: 10px;
  font-weight: 800;

  white-space: nowrap;

  cursor: pointer;

  transition:
    background 0.2s ease,
    border-color 0.2s ease,
    color 0.2s ease,
    transform 0.2s ease;
}

.category-tab:hover {
  transform: translateY(-1px);

  background: #f8fafc;

  border-color: #cfd6e2;
}


/* All */

.category-tab.active {
  background:
    linear-gradient(
      135deg,
      #2563eb,
      #4f46e5
    );

  border-color: #4f46e5;

  color: #ffffff;

  box-shadow:
    0 5px 13px rgba(79, 70, 229, 0.16);
}


/* Work */

.category-tab.work {
  color: #2563eb;
}

.category-tab.work.active {
  background: #eff6ff;

  border-color: #bfdbfe;

  color: #2563eb;

  box-shadow: none;
}


/* Family */

.category-tab.family {
  color: #c2410c;
}

.category-tab.family.active {
  background: #fff7ed;

  border-color: #fed7aa;

  color: #c2410c;

  box-shadow: none;
}


/* Friend */

.category-tab.friend {
  color: #15803d;
}

.category-tab.friend.active {
  background: #ecfdf3;

  border-color: #bbf7d0;

  color: #15803d;

  box-shadow: none;
}


/* Mobile */

@media (max-width: 650px) {
  .category-tabs {
    width: 100%;

    padding-bottom: 5px;
  }

  .category-tab {
    flex: 0 0 auto;
  }
}
/* =========================================================
   LOGIN PAGE
========================================================= */

.login-page {
  min-height: 100vh;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 30px 20px;

  box-sizing: border-box;

  background: #f5f7fb;
}


.login-card {
  width: 100%;
  max-width: 420px;

  padding: 36px;

  box-sizing: border-box;

  background: #ffffff;

  border: 1px solid #e5e7eb;

  border-radius: 16px;

  box-shadow:
    0 15px 45px
    rgba(0, 0, 0, 0.08);
}


.login-header {
  text-align: center;

  margin-bottom: 28px;
}


.login-icon {
  width: 52px;
  height: 52px;

  display: flex;
  align-items: center;
  justify-content: center;

  margin: 0 auto 15px;

  border-radius: 14px;

  background: #2563eb;

  color: #ffffff;

  font-size: 24px;
}


.login-header h1 {
  margin: 0;

  color: #111827;

  font-size: 25px;

  font-weight: 800;
}


.login-header p {
  margin: 7px 0 0;

  color: #6b7280;

  font-size: 13px;
}


.login-error {
  margin-bottom: 18px;

  padding: 11px 13px;

  border-radius: 8px;

  background: #fef2f2;

  border: 1px solid #fecaca;

  color: #b91c1c;

  font-size: 12px;
}


.login-form {
  display: flex;

  flex-direction: column;

  gap: 18px;
}


.login-field {
  display: flex;

  flex-direction: column;

  gap: 7px;
}


.login-field label {
  color: #374151;

  font-size: 12px;

  font-weight: 700;
}


.login-field input {
  width: 100%;

  min-height: 45px;

  padding: 0 13px;

  box-sizing: border-box;

  border: 1px solid #d1d5db;

  border-radius: 8px;

  outline: none;

  background: #ffffff;

  color: #111827;

  font-size: 13px;
}


.login-field input:focus {
  border-color: #2563eb;

  box-shadow:
    0 0 0 3px
    rgba(37, 99, 235, 0.10);
}


.login-password-wrapper {
  position: relative;
}


.login-password-wrapper input {
  padding-right: 60px;
}


.login-show-password {
  position: absolute;

  top: 50%;
  right: 10px;

  transform: translateY(-50%);

  padding: 4px;

  border: none;

  background: transparent;

  color: #2563eb;

  font-size: 10px;

  font-weight: 700;

  cursor: pointer;
}


.login-submit {
  width: 100%;

  min-height: 45px;

  margin-top: 3px;

  border: none;

  border-radius: 8px;

  background: #2563eb;

  color: #ffffff;

  font-size: 13px;

  font-weight: 750;

  cursor: pointer;

  transition:
    background 0.2s ease,
    transform 0.2s ease;
}


.login-submit:hover:not(:disabled) {
  background: #1d4ed8;

  transform: translateY(-1px);
}


.login-submit:disabled {
  opacity: 0.6;

  cursor: not-allowed;
}


.login-divider {
  display: flex;

  align-items: center;

  gap: 10px;

  margin: 24px 0 18px;
}


.login-divider span {
  flex: 1;

  height: 1px;

  background: #e5e7eb;
}


.login-divider p {
  margin: 0;

  color: #9ca3af;

  font-size: 9px;

  font-weight: 700;
}


.login-google {
  width: 100%;

  min-height: 45px;

  display: flex;

  align-items: center;

  justify-content: center;

  gap: 10px;

  border: 1px solid #d1d5db;

  border-radius: 8px;

  background: #ffffff;

  color: #374151;

  font-size: 12px;

  font-weight: 700;

  cursor: pointer;
}


.login-google:hover {
  background: #f9fafb;
}


.login-google-icon {
  font-size: 18px;

  font-weight: 900;

  color: #4285f4;
}


.login-register {
  display: flex;

  justify-content: center;

  gap: 5px;

  margin-top: 22px;

  color: #6b7280;

  font-size: 11px;
}


.login-register button {
  padding: 0;

  border: none;

  background: transparent;

  color: #2563eb;

  font-size: 11px;

  font-weight: 750;

  cursor: pointer;
}


.login-register button:hover {
  text-decoration: underline;
}


@media (max-width: 500px) {

  .login-page {
    padding: 20px 15px;
  }


  .login-card {
    padding: 28px 22px;
  }


  .login-header h1 {
    font-size: 22px;
  }

}
/* =========================================================
   LOGIN REDESIGN
========================================================= */

.login-page {
  position: relative;

  overflow: hidden;

  background:
    radial-gradient(
      circle at 8% 15%,
      rgba(37, 99, 235, 0.14),
      transparent 32%
    ),
    #eef2f7;
}

.login-shell {
  width: min(100%, 960px);
  min-height: 590px;

  display: grid;
  grid-template-columns: 0.9fr 1.1fr;

  overflow: hidden;

  border: 1px solid #dfe5ed;
  border-radius: 22px;

  background: #ffffff;

  box-shadow:
    0 24px 70px rgba(15, 23, 42, 0.12);
}

.login-shell {
  display: block;
  width: min(100%, 500px);
  min-height: 0;
}

.login-shell .login-card {
  padding: 52px 58px;
}

.password-label {
  position: relative;
}

.password-label .login-show-password {
  top: 50%;
  right: 0;
  transform: translateY(-50%);
}

.login-visual {
  display: flex;
  flex-direction: column;
  justify-content: space-between;

  padding: 38px;

  background:
    linear-gradient(150deg, #111c35 0%, #172d52 58%, #1d4b78 100%);
  color: #ffffff;
}

.login-visual-brand {
  display: flex;
  align-items: center;
  gap: 11px;
}

.login-visual-brand .login-icon {
  width: 42px;
  height: 42px;

  margin: 0;

  border-radius: 12px;

  background: #ffffff;
  color: #1d4b78;

  font-size: 19px;
}

.login-visual-brand strong,
.login-visual-brand span {
  display: block;
}

.login-visual-brand strong {
  font-size: 13px;
  letter-spacing: 1.6px;
}

.login-visual-brand span {
  margin-top: 3px;

  color: #9fb5d1;
  font-size: 10px;
}

.login-visual-copy {
  max-width: 295px;
}

.login-eyebrow {
  color: #8cc8ff;
  font-size: 9px;
  font-weight: 850;
  letter-spacing: 1.4px;
}

.login-visual-copy h2 {
  margin: 14px 0 15px;

  color: #ffffff;
  font-size: clamp(28px, 3vw, 39px);
  font-weight: 850;
  letter-spacing: 0;
  line-height: 1.08;
}

.login-visual-copy p {
  margin: 0;

  color: #b6c7dc;
  font-size: 12px;
  line-height: 1.7;
}

.login-visual-footer {
  display: flex;
  align-items: center;
  gap: 8px;

  color: #b6c7dc;
  font-size: 10px;
}

.login-status-dot {
  width: 7px;
  height: 7px;

  border-radius: 50%;

  background: #4ade80;
  box-shadow: 0 0 0 4px rgba(74, 222, 128, 0.14);
}

.login-shell .login-card {
  max-width: none;

  display: flex;
  flex-direction: column;
  justify-content: center;

  padding: 58px 68px;

  border: none;
  border-radius: 0;
  box-shadow: none;
}

.login-heading {
  font-size: 30px !important;
  letter-spacing: -0.4px;
}

.login-header {
  margin-bottom: 32px;
  text-align: left;
}

.login-header p {
  margin-top: 9px;
}

.login-field input {
  min-height: 49px;
  border-radius: 10px;
  background: #fbfcfe;
}

.login-submit {
  min-height: 49px;
  margin-top: 7px;
  border-radius: 10px;
  background: #2257d6;
  box-shadow: 0 8px 18px rgba(34, 87, 214, 0.2);
}

.login-submit:hover:not(:disabled) {
  background: #1948b9;
  box-shadow: 0 10px 22px rgba(34, 87, 214, 0.28);
}

@media (max-width: 720px) {
  .login-shell {
    min-height: 0;
  }

  .login-visual {
    min-height: 245px;
    padding: 28px;
  }

  .login-visual-copy {
    max-width: 470px;
    margin-top: 42px;
  }

  .login-visual-copy h2 {
    margin: 9px 0 0;
    font-size: 27px;
  }

  .login-visual-copy p,
  .login-visual-footer {
    display: none;
  }

  .login-shell .login-card {
    padding: 38px 28px 34px;
  }
}

/* =========================================================
   DARK LOGIN THEME
========================================================= */

.login-page {
  background:
    radial-gradient(
      circle at 15% 18%,
      rgba(37, 99, 235, 0.22),
      transparent 30%
    ),
    radial-gradient(
      circle at 90% 85%,
      rgba(14, 165, 233, 0.12),
      transparent 28%
    ),
    #080d18;
}

.login-shell {
  border-color: rgba(148, 163, 184, 0.18);
  background: #101827;
  box-shadow: 0 28px 90px rgba(0, 0, 0, 0.4);
}

.login-visual {
  background:
    linear-gradient(145deg, rgba(31, 63, 128, 0.9), rgba(11, 22, 42, 0.98)),
    #101d36;
}

.login-shell .login-card {
  background: #101827;
}

.login-heading {
  color: #f8fafc !important;
}

.login-header p {
  color: #94a3b8;
}

.login-field label {
  color: #cbd5e1;
}

.login-field input {
  border-color: #2b3950;
  background: #0b1220;
  color: #f8fafc;
}

.login-field input::placeholder {
  color: #64748b;
}

.login-field input:focus {
  border-color: #4f8cff;
  background: #0d1728;
  box-shadow: 0 0 0 3px rgba(79, 140, 255, 0.16);
}

.login-show-password {
  color: #74a6ff;
}

.login-submit {
  background: #3b82f6;
  box-shadow: 0 10px 24px rgba(59, 130, 246, 0.24);
}

.login-submit:hover:not(:disabled) {
  background: #60a5fa;
  color: #08111f;
}

.login-error {
  border-color: rgba(248, 113, 113, 0.35);
  background: rgba(127, 29, 29, 0.24);
  color: #fda4af;
}

 /* =========================================================
    REGISTER PAGE
 ========================================================= */

.register-page {
  min-height: 100vh;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40px 20px;
  box-sizing: border-box;
  background: var(--background, #f5f7fb);
}


.register-card {
  width: 100%;
  max-width: 480px;
  padding: 40px;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 20px;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.08);
}


.register-header {
  text-align: center;
  margin-bottom: 28px;
}


.register-icon {
  width: 64px;
  height: 64px;
  margin: 0 auto 16px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 18px;

  font-size: 28px;

  background: #eef2ff;
}


.register-brand {
  margin-bottom: 8px;

  font-size: 13px;
  font-weight: 700;
  letter-spacing: 2px;

  opacity: 0.65;
}


.register-heading {
  margin: 0 0 8px;

  font-size: 30px;
  line-height: 1.2;
  font-weight: 700;
}


.register-header p {
  margin: 0;

  font-size: 14px;
  line-height: 1.6;

  opacity: 0.65;
}


/* =========================================================
   ERROR
========================================================= */

.register-error {
  margin-bottom: 20px;
  padding: 12px 14px;

  border-radius: 10px;

  background: #fff1f2;
  border: 1px solid #fecdd3;

  color: #be123c;

  font-size: 14px;
  line-height: 1.5;
}


/* =========================================================
   FORM
========================================================= */

.register-form {
  display: flex;
  flex-direction: column;
  gap: 18px;
}


.register-field {
  display: flex;
  flex-direction: column;
  gap: 8px;
}


.register-field label {
  font-size: 14px;
  font-weight: 600;
}


.register-field input {
  width: 100%;
  height: 48px;

  padding: 0 14px;

  box-sizing: border-box;

  border: 1px solid #d9dee8;
  border-radius: 10px;

  background: #ffffff;

  font-size: 14px;

  outline: none;

  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}


.register-field input:focus {
  border-color: #6366f1;

  box-shadow:
    0 0 0 3px rgba(99, 102, 241, 0.12);
}


.register-field input::placeholder {
  color: #9ca3af;
}


.register-field small {
  font-size: 12px;
  line-height: 1.4;

  opacity: 0.6;
}


/* =========================================================
   PASSWORD LABEL
========================================================= */

.register-password-label {
  display: flex !important;
  align-items: center;
  justify-content: space-between;
}


.register-show-password {
  border: none;
  padding: 0;

  background: transparent;

  font-size: 12px;
  font-weight: 600;

  cursor: pointer;

  opacity: 0.7;
}


.register-show-password:hover {
  opacity: 1;
}


/* =========================================================
   SUBMIT BUTTON
========================================================= */

.register-submit {
  width: 100%;
  height: 48px;

  margin-top: 4px;

  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;

  border: none;
  border-radius: 10px;

  background: #111827;
  color: #ffffff;

  font-size: 14px;
  font-weight: 600;

  cursor: pointer;

  transition:
    transform 0.2s ease,
    opacity 0.2s ease,
    box-shadow 0.2s ease;
}


.register-submit:hover:not(:disabled) {
  transform: translateY(-1px);

  box-shadow:
    0 8px 20px rgba(0, 0, 0, 0.12);
}


.register-submit:disabled {
  cursor: not-allowed;
  opacity: 0.6;
}


/* =========================================================
   LOADING SPINNER
========================================================= */

.register-submit .loading-spinner {
  width: 16px;
  height: 16px;

  border: 2px solid rgba(255, 255, 255, 0.4);
  border-top-color: #ffffff;

  border-radius: 50%;

  animation: register-spin 0.7s linear infinite;
}


@keyframes register-spin {
  to {
    transform: rotate(360deg);
  }
}


/* =========================================================
   LOGIN LINK
========================================================= */

.register-login {
  margin-top: 24px;

  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;

  font-size: 14px;

  opacity: 0.75;
}


.register-login button {
  border: none;
  padding: 0;

  background: transparent;

  font-size: 14px;
  font-weight: 600;

  cursor: pointer;
}


.register-login button:hover {
  text-decoration: underline;
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

  .register-page {
    padding: 20px 14px;
  }


  .register-card {
    padding: 28px 22px;
    border-radius: 16px;
  }


  .register-heading {
    font-size: 26px;
  }

}

/* =========================================================
   DARK REGISTER THEME
========================================================= */

.register-page {
  background:
    radial-gradient(
      circle at 15% 18%,
      rgba(37, 99, 235, 0.22),
      transparent 30%
    ),
    radial-gradient(
      circle at 90% 85%,
      rgba(14, 165, 233, 0.12),
      transparent 28%
    ),
    #080d18;
}

.register-card {
  max-width: 500px;
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 18px;
  background: #101827;
  box-shadow: 0 28px 90px rgba(0, 0, 0, 0.4);
}

.register-icon {
  background: #1d4b78;
  color: #dbeafe;
}

.register-brand,
.register-header p,
.register-field small,
.register-login {
  color: #94a3b8;
}

.register-heading,
.register-field label {
  color: #f8fafc;
}

.register-field input {
  border-color: #2b3950;
  background: #0b1220;
  color: #f8fafc;
}

.register-field input::placeholder {
  color: #64748b;
}

.register-field input:focus {
  border-color: #4f8cff;
  background: #0d1728;
  box-shadow: 0 0 0 3px rgba(79, 140, 255, 0.16);
}

.register-show-password,
.register-login button {
  color: #74a6ff;
}

.register-submit {
  background: #3b82f6;
  box-shadow: 0 10px 24px rgba(59, 130, 246, 0.24);
}

.register-submit:hover:not(:disabled) {
  background: #60a5fa;
  box-shadow: 0 12px 26px rgba(59, 130, 246, 0.3);
}

.register-error {
  border-color: rgba(248, 113, 113, 0.35);
  background: rgba(127, 29, 29, 0.24);
  color: #fda4af;
}

.login-demo { margin-top: 12px; text-align: center; }
.login-demo-button { border: 1px solid #dbe3ff; background: #f7f9ff; color: #3346d3; border-radius: 8px; padding: 9px 14px; cursor: pointer; font-weight: 600; }

/* =========================================================
   CONTACT INFO ROWS (grid + list)
   ========================================================= */

.contact-info {
  display: flex;
  flex-direction: column;

  gap: 12px;

  margin-top: 20px;
}

.contact-info-row {
  display: flex;
  align-items: center;

  gap: 11px;

  min-width: 0;
}


/* =========================================================
   LIST CONTROLS (view · sort · density · filters)
   ========================================================= */

.list-controls {
  display: flex;
  align-items: center;
  flex-wrap: wrap;

  gap: 10px;

  margin-bottom: 16px;
}

.view-toggle {
  display: inline-flex;

  padding: 4px;

  border: 1px solid #e1e6ee;
  border-radius: 999px;

  background: #f6f8fc;
}

.view-toggle button {
  width: 34px;
  height: 30px;

  padding: 0;

  border: none;
  border-radius: 999px;

  background: transparent;

  color: #667085;

  font-size: 13px;

  transition:
    background 0.18s ease,
    color 0.18s ease,
    box-shadow 0.18s ease;
}

.view-toggle button:hover {
  color: #344054;
}

.view-toggle button.active {
  background: #ffffff;

  color: #2563eb;

  box-shadow: 0 2px 6px rgba(15, 23, 42, 0.09);
}

.control-field {
  display: inline-flex;
  align-items: center;

  gap: 7px;

  height: 38px;

  padding: 0 14px;

  border: 1px solid #e1e6ee;
  border-radius: 999px;

  background: #ffffff;

  color: #98a2b3;

  font-size: 9px;
  font-weight: 800;

  letter-spacing: 0.6px;
  text-transform: uppercase;
}

.control-field select {
  padding: 0;

  border: none;
  outline: none;

  background: transparent;

  color: #344054;

  font-size: 11px;
  font-weight: 750;

  letter-spacing: 0;
  text-transform: none;

  cursor: pointer;
}

.filter-toggle {
  display: inline-flex;
  align-items: center;

  gap: 7px;

  height: 38px;

  padding: 0 15px;

  border: 1px solid #e1e6ee;
  border-radius: 999px;

  background: #ffffff;

  color: #667085;

  font-size: 10px;
  font-weight: 800;

  cursor: pointer;

  transition:
    background 0.18s ease,
    border-color 0.18s ease,
    color 0.18s ease;
}

.filter-toggle:hover {
  background: #f8fafc;

  border-color: #cfd6e2;
}

.filter-toggle.active {
  background: #eef2ff;

  border-color: #c7d2fe;

  color: #4338ca;
}

.filter-count {
  min-width: 17px;
  height: 17px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  padding: 0 5px;

  border-radius: 999px;

  background: #4f46e5;

  color: #ffffff;

  font-size: 8px;
  font-weight: 850;
}


/* =========================================================
   BULK ACTIONS BAR
   ========================================================= */

.bulk-bar {
  display: flex;
  align-items: center;
  flex-wrap: wrap;

  gap: 9px;

  margin-bottom: 14px;

  padding: 9px 13px;

  border: 1px solid #c7d2fe;
  border-radius: 10px;

  background: #eef2ff;
}

.bulk-bar strong {
  color: #3730a3;

  font-size: 11px;
  font-weight: 800;
}

.bulk-bar button {
  height: 30px;

  padding: 0 11px;

  border: 1px solid #dbe1ff;
  border-radius: 8px;

  background: #ffffff;

  color: #4338ca;

  font-size: 10px;
  font-weight: 800;

  cursor: pointer;

  transition:
    background 0.18s ease,
    border-color 0.18s ease;
}

.bulk-bar button:hover {
  background: #f8faff;

  border-color: #c7d2fe;
}

.bulk-bar .bulk-delete {
  border-color: #ffe0e4;

  background: #fff5f6;

  color: #be123c;
}

.bulk-bar .bulk-delete:hover {
  background: #ffecee;
}

.bulk-bar button:disabled {
  opacity: 0.55;

  cursor: not-allowed;
}


/* =========================================================
   RESULTS LAYOUT + FILTER SIDEBAR
   ========================================================= */

.contacts-layout {
  display: grid;

  grid-template-columns: minmax(0, 1fr);

  gap: 18px;
}

.contacts-layout.has-filters {
  grid-template-columns: 218px minmax(0, 1fr);
}

.contacts-main {
  min-width: 0;
}

.filter-sidebar {
  align-self: start;

  position: sticky;
  top: 92px;

  padding: 15px;

  border: 1px solid #e7ebf1;
  border-radius: 13px;

  background: #fbfcfe;
}

.filter-sidebar-head {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-bottom: 13px;
}

.filter-sidebar-head span {
  color: #98a2b3;

  font-size: 9px;
  font-weight: 850;

  letter-spacing: 1.1px;
}

.filter-sidebar-head button {
  padding: 0;

  border: none;

  background: transparent;

  color: #4f46e5;

  font-size: 10px;
  font-weight: 800;

  cursor: pointer;
}

.filter-sidebar-head button:hover {
  text-decoration: underline;
}

.filter-group {
  padding: 12px 0;

  border-top: 1px solid #edf0f4;
}

.filter-group:first-of-type {
  padding-top: 0;

  border-top: none;
}

.filter-group-label {
  display: block;

  margin-bottom: 8px;

  color: #a0a9b7;

  font-size: 8px;
  font-weight: 850;

  letter-spacing: 0.9px;
}

.filter-check {
  display: flex;
  align-items: center;

  gap: 8px;

  min-height: 26px;

  color: #475467;

  font-size: 11px;
  font-weight: 650;

  cursor: pointer;
}

.filter-check input {
  width: 14px;
  height: 14px;

  accent-color: #4f46e5;

  cursor: pointer;
}

.filter-group select,
.filter-group input[type="date"] {
  width: 100%;
  height: 34px;

  margin-bottom: 7px;

  padding: 0 9px;

  border: 1px solid #dfe4eb;
  border-radius: 8px;

  outline: none;

  background: #ffffff;

  color: #344054;

  font-size: 11px;

  cursor: pointer;
}

.filter-group input[type="date"]:last-child {
  margin-bottom: 0;
}

.filter-group select:focus,
.filter-group input[type="date"]:focus {
  border-color: #818cf8;

  box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.08);
}


/* =========================================================
   RECENT SEARCHES DROPDOWN
   ========================================================= */

.recent-dropdown {
  position: absolute;

  left: 0;
  right: 0;
  top: calc(100% + 6px);

  z-index: 30;

  padding: 7px;

  border: 1px solid #e5e9f0;
  border-radius: 11px;

  background: #ffffff;

  box-shadow: 0 14px 34px rgba(15, 23, 42, 0.12);
}

.recent-head {
  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 5px 8px 7px;
}

.recent-head span {
  color: #98a2b3;

  font-size: 8px;
  font-weight: 850;

  letter-spacing: 1px;
  text-transform: uppercase;
}

.recent-head button {
  padding: 0;

  border: none;

  background: transparent;

  color: #4f46e5;

  font-size: 10px;
  font-weight: 800;

  cursor: pointer;
}

.recent-item {
  display: flex;
  align-items: center;

  gap: 9px;

  width: 100%;
  min-height: 33px;

  padding: 0 9px;

  border: none;
  border-radius: 8px;

  background: transparent;

  color: #475467;

  font-size: 12px;

  text-align: left;

  cursor: pointer;
}

.recent-item:hover {
  background: #f4f6ff;

  color: #344054;
}

.recent-icon {
  color: #98a2b3;

  font-size: 12px;
}


/* =========================================================
   SKELETON LOADERS
   ========================================================= */

.skeleton-card {
  display: flex;
  align-items: center;

  gap: 14px;

  pointer-events: none;
}

.skeleton-shimmer {
  position: relative;

  overflow: hidden;

  background: #eef1f6;

  border-radius: 8px;
}

.skeleton-shimmer::after {
  content: "";

  position: absolute;
  inset: 0;

  transform: translateX(-100%);

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.75),
      transparent
    );

  animation: skeleton-shimmer 1.3s infinite;
}

@keyframes skeleton-shimmer {
  100% {
    transform: translateX(100%);
  }
}

.skeleton-avatar {
  width: 52px;
  height: 52px;

  flex-shrink: 0;

  border-radius: 15px;
}

.skeleton-lines {
  flex: 1;

  display: flex;
  flex-direction: column;

  gap: 9px;

  min-width: 0;
}

.skeleton-line {
  height: 11px;
}

.w-60 { width: 60%; }
.w-35 { width: 35%; }
.w-80 { width: 80%; }


/* =========================================================
   LIST VIEW (compact rows)
   ========================================================= */

.contacts.contacts-list {
  grid-template-columns: minmax(0, 1fr);

  gap: 9px;
}

.contact-card-modern.list-mode {
  display: flex;
  align-items: center;

  gap: 15px;

  padding: 11px 15px;

  border-radius: 12px;
}

.contact-card-modern.list-mode::before {
  height: 3px;
}

.contact-card-modern.list-mode .contact-card-top {
  flex: 1 1 240px;

  align-items: center;

  gap: 11px;
}

.contact-card-modern.list-mode .profile-area {
  gap: 11px;
}

.contact-card-modern.list-mode .profile-details {
  flex: 1;

  min-width: 0;
}

.contact-card-modern.list-mode .large-avatar {
  width: 38px;
  height: 38px;

  border-radius: 11px;

  font-size: 11px;
}

.contact-card-modern.list-mode .contact-category {
  margin-bottom: 2px;

  padding: 3px 7px;

  font-size: 7px;
}

.contact-card-modern.list-mode .profile-details h2 {
  font-size: 14px;

  line-height: 1.3;

  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.contact-card-modern.list-mode .contact-status {
  display: none;
}

.contact-card-modern.list-mode .more-button {
  width: 28px;
  height: 28px;

  font-size: 16px;
}

.contact-card-modern.list-mode .contact-info {
  flex: 1 1 auto;

  flex-direction: row;
  align-items: center;

  gap: 16px;

  margin-top: 0;
}

.contact-card-modern.list-mode .contact-info-row {
  flex: 0 1 auto;

  min-width: 0;
}

.contact-card-modern.list-mode .detail-icon,
.contact-card-modern.list-mode .info-label,
.contact-card-modern.list-mode .address-row {
  display: none;
}

.contact-card-modern.list-mode .detail-content strong {
  font-size: 12px;

  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;

  max-width: 220px;
}

.contact-card-modern.list-mode .card-divider {
  display: none;
}

.contact-card-modern.list-mode .modern-card-actions {
  flex: 0 0 auto;

  gap: 6px;
}

.contact-card-modern.list-mode .edit-contact-button {
  flex: 0 0 auto;

  min-height: 33px;

  padding: 0 11px;

  font-size: 10px;
}

.contact-card-modern.list-mode .modern-card-actions .delete-contact-button {
  min-height: 33px;

  padding: 0 11px;

  font-size: 10px;
}


/* =========================================================
   SELECTION CHECKBOX + SELECTED / FOCUSED CARD
   ========================================================= */

.card-checkbox {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  opacity: 0;

  transition: opacity 0.15s ease;

  cursor: pointer;
}

.card-checkbox input {
  width: 15px;
  height: 15px;

  accent-color: #4f46e5;

  cursor: pointer;
}

.contact-card-modern:hover .card-checkbox,
.contact-card-modern:focus-within .card-checkbox,
.contact-card-modern.is-selected .card-checkbox {
  opacity: 1;
}

.contact-card-modern.is-selected {
  border-color: #a5b4fc;

  box-shadow:
    0 0 0 2px rgba(99, 102, 241, 0.25),
    0 6px 18px rgba(15, 23, 42, 0.05);
}

.contact-card-modern:focus,
.contact-card-modern.is-focused {
  outline: none;

  border-color: #818cf8;

  box-shadow:
    0 0 0 3px rgba(99, 102, 241, 0.22),
    0 10px 24px rgba(15, 23, 42, 0.08);
}


/* =========================================================
   COMPACT DENSITY
   ========================================================= */

.density-compact .contacts {
  gap: 10px;
}

.density-compact .contacts.contacts-list {
  gap: 6px;
}

.density-compact .contact-card-modern.grid-mode {
  padding: 15px;

  border-radius: 14px;
}

.density-compact .contact-card-modern.grid-mode .large-avatar {
  width: 42px;
  height: 42px;

  border-radius: 12px;

  font-size: 12px;
}

.density-compact .contact-card-modern.grid-mode .profile-details h2 {
  font-size: 16px;
}

.density-compact .contact-card-modern.grid-mode .contact-status {
  display: none;
}

.density-compact .contact-card-modern.grid-mode .contact-info {
  gap: 8px;

  margin-top: 14px;
}

.density-compact .contact-card-modern.grid-mode .detail-icon {
  width: 30px;
  height: 30px;

  font-size: 11px;
}

.density-compact .contact-card-modern.grid-mode .card-divider {
  margin: 13px 0 11px;
}

.density-compact .contact-card-modern.grid-mode .modern-card-actions .edit-contact-button,
.density-compact .contact-card-modern.grid-mode .modern-card-actions .delete-contact-button {
  min-height: 34px;
}

.density-compact .contact-card-modern.list-mode {
  padding: 7px 13px;
}

.density-compact .contact-card-modern.list-mode .large-avatar {
  width: 30px;
  height: 30px;

  font-size: 10px;
}

.density-compact .contact-card-modern.list-mode .profile-details h2 {
  font-size: 13px;
}

.density-compact .skeleton-avatar {
  width: 42px;
  height: 42px;
}


/* =========================================================
   LISTING RESPONSIVE
   ========================================================= */

@media (max-width: 850px) {
  .contacts-layout.has-filters {
    grid-template-columns: minmax(0, 1fr);
  }

  .filter-sidebar {
    position: static;
  }
}

@media (max-width: 620px) {
  .list-controls {
    gap: 8px;
  }

  .control-field {
    padding: 0 8px;
  }

  .control-field span {
    display: none;
  }

  .contact-card-modern.list-mode {
    flex-wrap: wrap;

    gap: 10px;
  }

  .contact-card-modern.list-mode .contact-card-top {
    flex: 1 1 100%;
  }

  .contact-card-modern.list-mode .contact-info {
    flex: 1 1 100%;
  }

  .contact-card-modern.list-mode .modern-card-actions {
    width: 100%;
  }

  .contact-card-modern.list-mode .edit-contact-button {
    flex: 1;
  }

  .bulk-bar {
    gap: 7px;
  }
}
.login-demo-button:hover { background: #eef2ff; }


/* =========================================================
   CONTACT TABLE (list view)
   ---------------------------------------------------------
   table-layout: fixed gives every row the exact same
   column widths, so a long value can never push the
   Phone Number column (or any other) out of alignment.
   Long values truncate with an ellipsis + title tooltip.
   ========================================================= */

.contact-table-wrap {
  width: 100%;

  overflow-x: auto;

  border: 1px solid #e7ebf1;
  border-radius: 15px;

  background: #ffffff;

  box-shadow:
    0 6px 20px rgba(15, 23, 42, 0.04);
}

.contact-table {
  width: 100%;
  min-width: 880px;

  table-layout: fixed;

  border-collapse: separate;
  border-spacing: 0;
}


/* ----------------------------------------------
   COLUMN WIDTHS (consistent for every row)
---------------------------------------------- */

.contact-table .w-select {
  width: 46px;
}

.contact-table .w-name {
  width: 17%;
}

.contact-table .w-phone {
  width: 16%;
}

.contact-table .w-email {
  width: 20%;
}

.contact-table .w-category {
  width: 11%;
}

.contact-table .w-address {
  width: auto;
}

.contact-table .w-actions {
  width: 150px;
}


/* ----------------------------------------------
   HEADER
---------------------------------------------- */

.contact-table thead th {
  height: 46px;

  padding: 0 16px;

  border-bottom: 1px solid #e7ebf1;

  background: #f8fafd;

  color: #98a2b3;

  font-size: 9px;
  font-weight: 850;

  letter-spacing: 1.1px;
  text-transform: uppercase;

  text-align: left;

  vertical-align: middle;

  white-space: nowrap;
}


/* ----------------------------------------------
   BODY CELLS (equal padding + row height)
---------------------------------------------- */

.contact-table tbody tr {
  outline: none;
}

.contact-table tbody td {
  height: 72px;

  padding: 10px 16px;

  border-bottom: 1px solid #eef1f5;

  background: #ffffff;

  color: #475467;

  font-size: 12px;

  vertical-align: middle;
}

.contact-table tbody tr:last-child td {
  border-bottom: none;
}


/* ----------------------------------------------
   COLUMN ALIGNMENT
---------------------------------------------- */

.contact-table .col-select {
  padding: 0 10px;

  text-align: center;
}

.contact-table .col-actions {
  padding: 10px 14px;

  text-align: right;
}


/* ----------------------------------------------
   ROW STATES (hover · selected · keyboard focus)
---------------------------------------------- */

.contact-table tbody tr:hover td {
  background: #f9fbff;
}

.contact-table tbody tr.is-selected td {
  background: #eef2ff;
}

.contact-table tbody tr:focus td {
  background: #f5f7ff;
}

.contact-table tbody tr.is-selected td:first-child {
  box-shadow: inset 3px 0 0 #4f46e5;
}

.contact-table tbody tr:focus td:first-child {
  box-shadow: inset 3px 0 0 #818cf8;
}


/* ----------------------------------------------
   CELL CONTENT (truncates instead of overflowing)
---------------------------------------------- */

.cell-text {
  display: block;

  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cell-empty {
  display: block;

  color: #c4cbd6;

  font-size: 13px;
  font-weight: 750;
}

.table-person {
  display: flex;
  align-items: center;

  gap: 11px;

  min-width: 0;
}

.table-avatar {
  width: 34px;
  height: 34px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  border-radius: 10px;

  background:
    linear-gradient(
      135deg,
      #2563eb,
      #6366f1
    );

  color: #ffffff;

  font-size: 11px;
  font-weight: 850;
}

.table-name {
  color: #101828;

  font-size: 13px;
  font-weight: 750;
}


/*
 * Phone Number — the second column — stays on
 * one line and lines its digits up vertically.
 */
.table-phone {
  color: #344054;

  font-weight: 650;

  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";

  letter-spacing: 0.2px;
}

.table-email {
  color: #475467;
}

.table-address {
  color: #667085;
}

.contact-table .contact-category {
  margin-bottom: 0;
}


/* ----------------------------------------------
   SELECTION CHECKBOX
---------------------------------------------- */

.table-checkbox {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  cursor: pointer;
}

.table-checkbox input {
  width: 15px;
  height: 15px;

  accent-color: #4f46e5;

  cursor: pointer;
}


/* ----------------------------------------------
   ROW ACTIONS
---------------------------------------------- */

.table-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;

  gap: 6px;
}

.row-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  min-width: 52px;
  height: 30px;

  padding: 0 10px;

  border: 1px solid #e3e8f0;
  border-radius: 8px;

  background: #ffffff;

  color: #667085;

  font-size: 10px;
  font-weight: 800;

  text-decoration: none;

  white-space: nowrap;

  cursor: pointer;

  transition:
    background 0.18s ease,
    border-color 0.18s ease,
    color 0.18s ease,
    box-shadow 0.18s ease;
}

.row-action:hover {
  border-color: #cfd6e2;

  background: #f8fafc;

  color: #344054;
}

.edit-action {
  border-color: #dfe4ff;

  background: #f0f3ff;

  color: #4338ca;
}

.edit-action:hover {
  border-color: #c7d2fe;

  background: #e6eaff;

  color: #3730a3;

  box-shadow:
    0 4px 10px rgba(67, 56, 202, 0.08);
}

.delete-action {
  min-width: 60px;

  border-color: #ffe0e4;

  background: #fff5f6;

  color: #be123c;
}

.delete-action:hover {
  border-color: #fecdd3;

  background: #ffecee;

  box-shadow:
    0 4px 10px rgba(190, 18, 60, 0.07);
}

.row-action:disabled {
  opacity: 0.55;

  cursor: not-allowed;
}


/* ----------------------------------------------
   TABLE SKELETON LOADER
---------------------------------------------- */

.contact-table .skeleton-row td {
  pointer-events: none;
}

.contact-table .skeleton-line {
  display: block;
}

.skeleton-box {
  display: block;

  width: 15px;
  height: 15px;

  margin: 0 auto;

  border-radius: 4px;
}

.skeleton-pill {
  display: block;

  width: 54px;
  height: 18px;

  border-radius: 999px;
}

.w-70 {
  width: 70%;
}


/* ----------------------------------------------
   COMPACT DENSITY (matches virtual row height)
---------------------------------------------- */

.density-compact .contact-table tbody td {
  height: 54px;

  padding: 6px 16px;
}

.density-compact .contact-table .col-actions {
  padding: 6px 14px;
}

.density-compact .contact-table .col-select {
  padding: 0 10px;
}

.density-compact .contact-table .table-avatar {
  width: 28px;
  height: 28px;

  border-radius: 8px;

  font-size: 10px;
}

.density-compact .contact-table .table-name {
  font-size: 12px;
}

.density-compact .contact-table .row-action {
  height: 27px;
}


/* ----------------------------------------------
   NARROW SCREENS
   The table scrolls sideways instead of letting
   columns collapse and lose their alignment.
---------------------------------------------- */

@media (max-width: 620px) {
  .contact-table-wrap {
    border-radius: 12px;
  }

  .contact-table {
    min-width: 840px;
  }
}


/* =========================================================
   CONTACT CARD FIELDS (grid view)
   ---------------------------------------------------------
   The grid cards show the exact same clear labels as the
   table columns: Name · Phone Number · Email Address ·
   Category · Address — so every contact list in the app
   reads the same way.
   ========================================================= */

.contact-fields {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 15px 16px;

  margin-top: 21px;
}

.contact-field {
  min-width: 0;
}


/*
 * Field label — shared by the card header
 * and every field, matching the table headers.
 */
.field-label {
  display: block;

  margin-bottom: 5px;

  color: #98a2b3;

  font-size: 8px;
  font-weight: 850;

  letter-spacing: 0.9px;
  text-transform: uppercase;
}

.profile-details .field-label {
  margin-bottom: 3px;
}


/*
 * Field value — truncates instead of wrapping,
 * so every card keeps the same shape.
 */
.field-value {
  display: block;

  min-width: 0;

  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;

  color: #344054;

  font-size: 13px;
  font-weight: 650;

  line-height: 1.45;
}

.phone-value {
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";

  letter-spacing: 0.2px;
}

.field-value.address-value {
  display: -webkit-box;

  white-space: normal;

  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.field-empty {
  color: #c4cbd6;

  font-weight: 750;
}

.contact-fields .contact-category {
  margin-bottom: 0;
}


/* Compact density */

.density-compact .contact-card-modern.grid-mode .contact-fields {
  gap: 11px 14px;

  margin-top: 15px;
}

.density-compact .contact-card-modern.grid-mode .field-value {
  font-size: 12px;
}


/* Narrow cards — stack the fields in one column */

@media (max-width: 420px) {
  .contact-fields {
    grid-template-columns: minmax(0, 1fr);
  }
}


/* =========================================================
   PROFILE & SETTINGS
   ---------------------------------------------------------
   /profile — hero card, then a 2×2 grid of settings
   cards: Edit profile · Preferences · Change password ·
   Session.
   ========================================================= */

.profile-page {
  width: 100%;

  margin: 0;
  padding: 0;
}


/*
 * Sidebar user block → link
 */

a.sidebar-user {
  padding: 4px 6px;

  border-radius: 12px;

  color: inherit;
  text-decoration: none;

  cursor: pointer;

  transition: background 0.2s ease;
}

a.sidebar-user:hover {
  background: rgba(255, 255, 255, 0.05);
}

.sidebar-user-arrow {
  margin-left: auto;

  color: #778399;

  font-size: 13px;

  transition: color 0.2s ease;
}

a.sidebar-user:hover .sidebar-user-arrow {
  color: #cbd5e1;
}


/*
 * Hero
 */

.profile-hero {
  display: flex;
  align-items: center;

  gap: 18px;

  margin-bottom: 20px;

  padding: 24px 26px;

  border: 1px solid #e8ecf2;
  border-radius: 22px;

  background: rgba(255, 255, 255, 0.78);

  -webkit-backdrop-filter: blur(18px);
  backdrop-filter: blur(18px);

  box-shadow:
    0 14px 40px rgba(15, 23, 42, 0.07);
}

.profile-avatar-xl {
  width: 74px;
  height: 74px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  border-radius: 20px;

  background:
    linear-gradient(
      135deg,
      #2563eb,
      #4f46e5
    );

  color: #ffffff;

  font-size: 24px;
  font-weight: 850;

  letter-spacing: 0.5px;

  box-shadow:
    0 10px 22px rgba(37, 99, 235, 0.22);
}

.profile-hero-info {
  min-width: 0;
}

.profile-hero-info h2 {
  margin: 0;

  color: #101828;

  font-size: 21px;
  font-weight: 850;

  letter-spacing: -0.4px;
}

.profile-hero-email {
  display: block;

  margin-top: 5px;

  color: #667085;

  font-size: 12px;

  overflow-wrap: anywhere;
}

.profile-hero-chips {
  display: flex;
  align-items: center;
  flex-wrap: wrap;

  gap: 8px;

  margin-left: auto;
}

.profile-chip {
  display: inline-flex;
  align-items: center;

  gap: 7px;

  padding: 7px 12px;

  border: 1px solid #e6eaf0;
  border-radius: 999px;

  background: #ffffff;

  color: #667085;

  font-size: 10px;
  font-weight: 750;
}

.chip-dot {
  width: 6px;
  height: 6px;

  flex-shrink: 0;

  border-radius: 50%;

  background: #22c55e;

  box-shadow:
    0 0 0 3px rgba(34, 197, 94, 0.12);
}


/*
 * Settings grid
 */

.settings-grid {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 20px;
}

.settings-card {
  display: flex;
  flex-direction: column;

  padding: 26px;

  border: 1px solid #e8ecf2;
  border-radius: 22px;

  background: rgba(255, 255, 255, 0.78);

  -webkit-backdrop-filter: blur(18px);
  backdrop-filter: blur(18px);

  box-shadow:
    0 14px 40px rgba(15, 23, 42, 0.07);
}

.settings-card-title {
  display: flex;
  align-items: center;

  gap: 13px;

  margin-bottom: 20px;

  padding-bottom: 17px;

  border-bottom: 1px solid #edf0f4;
}

.settings-icon {
  width: 41px;
  height: 41px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  border-radius: 11px;

  font-size: 16px;
}

.settings-icon.indigo {
  background: #eef2ff;
  color: #4f46e5;
}

.settings-icon.violet {
  background: #f5f3ff;
  color: #7c3aed;
}

.settings-icon.blue {
  background: #eff6ff;
  color: #2563eb;
}

.settings-icon.green {
  background: #f0fdf4;
  color: #15803d;
}

.settings-card-title h2 {
  margin: 0;

  color: #101828;

  font-size: 15px;
  font-weight: 850;
}

.settings-card-title p {
  margin: 4px 0 0;

  color: #8a94a4;

  font-size: 11px;

  line-height: 1.5;
}


/*
 * Preference rows
 */

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 16px;

  padding: 15px 0;

  border-bottom: 1px solid #f1f4f8;
}

.setting-row:last-of-type {
  border-bottom: none;

  padding-bottom: 5px;
}

.setting-text {
  min-width: 0;
}

.setting-text strong {
  display: block;

  color: #344054;

  font-size: 12px;
  font-weight: 800;
}

.setting-text span {
  display: block;

  margin-top: 4px;

  color: #98a2b3;

  font-size: 10px;

  line-height: 1.5;
}


/*
 * Segmented control (Grid/Table · densities)
 */

.segmented {
  display: inline-flex;

  flex-shrink: 0;

  gap: 4px;

  padding: 4px;

  border: 1px solid #e6eaf0;
  border-radius: 10px;

  background: #f8fafc;
}

.segmented button {
  min-height: 32px;

  padding: 0 13px;

  border: none;
  border-radius: 7px;

  background: transparent;

  color: #667085;

  font: inherit;
  font-size: 10px;
  font-weight: 800;

  letter-spacing: 0.3px;

  cursor: pointer;

  transition:
    background 0.2s ease,
    color 0.2s ease,
    box-shadow 0.2s ease;
}

.segmented button:hover {
  background: #eef2f7;

  color: #344054;
}

.segmented button.active {
  background: #ffffff;

  color: #2563eb;

  box-shadow:
    0 2px 6px rgba(15, 23, 42, 0.08);
}


/*
 * Card helpers
 */

.settings-note {
  margin: 14px 0 0;

  color: #98a2b3;

  font-size: 10px;

  line-height: 1.6;
}

.field-hint {
  display: block;

  margin-top: 6px;

  color: #98a2b3;

  font-size: 10px;

  line-height: 1.5;
}

.settings-card .form-group input:disabled {
  background: #f8fafc;

  color: #98a2b3;

  cursor: not-allowed;
}

.settings-card .form-actions button:disabled {
  opacity: 0.55;

  cursor: not-allowed;

  transform: none;

  box-shadow: none;
}


/*
 * Session card
 */

.session-list {
  display: flex;
  flex-direction: column;
}

.session-row {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 14px;

  padding: 13px 0;

  border-bottom: 1px solid #f1f4f8;
}

.session-row:last-of-type {
  border-bottom: none;
}

.session-row > span {
  color: #98a2b3;

  font-size: 9px;
  font-weight: 800;

  letter-spacing: 0.9px;
  text-transform: uppercase;
}

.session-row > strong {
  color: #344054;

  font-size: 12px;
  font-weight: 750;

  text-align: right;

  overflow-wrap: anywhere;
}

.session-status {
  display: inline-flex;
  align-items: center;

  gap: 7px;

  color: #15803d !important;
}

.status-live {
  width: 7px;
  height: 7px;

  border-radius: 50%;

  background: #22c55e;

  box-shadow:
    0 0 0 3px rgba(34, 197, 94, 0.12);
}

.session-logout {
  width: 100%;

  min-height: 41px;

  margin-top: 16px;

  border: 1px solid #fecdd3;
  border-radius: 9px;

  background: #fff7f8;

  color: #e11d48;

  font: inherit;
  font-size: 10px;
  font-weight: 800;

  cursor: pointer;

  transition:
    background 0.2s ease,
    border-color 0.2s ease,
    transform 0.2s ease;
}

.session-logout:hover {
  background: #fff1f3;

  border-color: #fda4af;

  transform: translateY(-1px);
}


/*
 * Responsive
 */

@media (max-width: 1050px) {
  .settings-grid {
    grid-template-columns:
      minmax(0, 1fr);
  }
}

@media (max-width: 620px) {
  .profile-hero {
    flex-wrap: wrap;

    padding: 20px;
  }

  .profile-hero-chips {
    width: 100%;

    margin-left: 0;
  }

  .setting-row {
    flex-direction: column;
    align-items: flex-start;
  }

  .segmented {
    width: 100%;
  }

  .segmented button {
    flex: 1;
  }
}
